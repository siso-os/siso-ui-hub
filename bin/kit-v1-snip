#!/usr/bin/env python3
"""Cut each candidate part to what a reader needs to judge it (exports, props, variants, the start of its JSX) and write
batches of 25 for the Haiku readers: /tmp/kitv1/batches/<n>.txt. Usage: kit-v1-snip <category prefixes...>"""
import json, os, re, sys
HUB = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
idx = json.load(open(f"{HUB}/app/src/kit/index.json"))["parts"]
pref = tuple(sys.argv[1:])
def snip(src):
    pk = sorted(set(re.findall(r'from\s+["\']((?:@[\w-]+/)?[\w.-]+)', src)) - {"react"})
    body = re.sub(r"^import[^;]*?;?\n", "", src, flags=re.M)
    body = re.sub(r"\n\s*\n+", "\n", body)
    body = re.sub(r"className=\{?[\"'`][^\"'`]{60,}[\"'`]\}?", 'className="…"', body)
    return ("packages: " + ", ".join(pk) + "\n" + body)[:2200]
parts = [r for r in idx if r[2].startswith(pref) and r[5]]
os.makedirs("/tmp/kitv1/batches", exist_ok=True)
for n in range(0, len(parts), 25):
    with open(f"/tmp/kitv1/batches/{n // 25:03d}.txt", "w") as f:
        for r in parts[n:n + 25]:
            lib = r[0].split("/")[0]
            try: src = open(f"{HUB}/app/src/kit/{lib}/{r[4]}", errors="ignore").read()
            except OSError: continue
            f.write(f"\n===== {r[0]} | {r[1]} | filed as {r[2]}\n{snip(src)}\n")
print(len(parts), "parts in", (len(parts) + 24) // 25, "batches")

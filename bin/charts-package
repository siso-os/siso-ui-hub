#!/usr/bin/env python3
"""Recode Evil Charts' recharts parts (app/src/kit/evilcharts) into the SISO chart package (packages/siso-charts).
Renames Evil* to Siso*, drops the "recharts-" file prefix, points cn at the package's own lib/utils, and applies the
hover-card fix. Re-run after any change to PATCHES; the output is committed. Usage: bin/charts-package"""
import re, pathlib
ROOT = pathlib.Path(__file__).resolve().parent.parent
KIT = ROOT / "app/src/kit/evilcharts"
OUT = ROOT / "packages/siso-charts/src"
PARTS = {"ui": ["chart", "tooltip", "legend", "dot", "brush", "background"],
         "charts": ["area-chart", "bar-chart", "line-chart", "pie-chart", "radar-chart", "radial-chart", "composed-chart", "sankey-chart"]}
HEAD = "// Recoded from Evil Charts (MIT, evilcharts.com) into the SISO chart package. Edit packages/siso-charts, not the kit copy.\n"

def recode(s: str) -> str:
    s = s.replace("Evil", "Siso").replace('"evil-', '"siso-')
    s = re.sub(r'(["\'/])recharts-(chart|tooltip|legend|dot|brush|background)"', r'\1\2"', s)
    s = s.replace('"motion/react"', '"framer-motion"')
    s = s.replace('"@/arc-shims/kit-utils"', '"../lib/utils"')
    return s

# (file, old, new): each must match exactly once or the script stops
PATCHES = [
  ("ui/tooltip.tsx",
   '"border-border/50 grid min-w-32 items-start gap-1.5 border px-2.5 py-1.5 text-xs shadow-xl"',
   '"border-border/50 grid w-max min-w-40 max-w-72 items-start gap-1.5 border px-3 py-2 text-xs shadow-xl"'),
  ("ui/tooltip.tsx",
   '"[&>svg]:text-muted-foreground flex w-full flex-wrap items-stretch gap-2 [&>svg]:h-2.5 [&>svg]:w-2.5"',
   '"[&>svg]:text-muted-foreground flex w-full flex-nowrap items-stretch gap-2 [&>svg]:h-2.5 [&>svg]:w-2.5"'),
  ("ui/tooltip.tsx",
   '"flex flex-1 justify-between gap-4 leading-none"',
   '"flex min-w-0 flex-1 justify-between gap-6 leading-none whitespace-nowrap"'),
  ("ui/tooltip.tsx",
   'return <span className="p-4" />;',
   'return <span className="block size-4" />;'),
]
for sub, names in PARTS.items():
    (OUT / sub).mkdir(parents=True, exist_ok=True)
    for n in names:
        src = (KIT / sub / f"recharts-{n}.tsx").read_text()
        (OUT / sub / f"{n}.tsx").write_text(HEAD + recode(src))
for f, old, new in PATCHES:
    p = OUT / f; t = p.read_text()
    if t.count(old) != 1: raise SystemExit(f"patch does not apply once: {f}: {old[:50]}")
    p.write_text(t.replace(old, new))

# ---- UI Arc (uiarc registry, in siso-ui-code): Shaan's favourite look, recoded for the package ----
import json
R = ROOT.parent / "siso-ui-code/r/uiarc"
ARC = OUT / "arc"; (ARC / "lib").mkdir(parents=True, exist_ok=True)
ARC_PARTS = ["bar-chart", "line-chart", "donut-chart", "activity-heatmap", "sparkline", "gauge"]
AHEAD = "// uihub: siso:charts\n// Recoded from UI Arc (uiarc registry) into the SISO chart package: framer-motion in place of motion, tokens from ../tokens, host colour through ArcScope. Edit packages/siso-charts, not the registry copy.\n"
def arc_files(name):
    out = {}
    for x in json.loads((R / f"{name}.json").read_text())["files"]:  # two files can share a name (motion-tokens.ts): keep the longer, the real one
        fn = (x.get("target") or x["path"]).split("/")[-1]
        if x.get("content") and len(x["content"]) >= len(out.get(fn, "")): out[fn] = x["content"]
    return out
(ARC / "lib" / "motion-tokens.ts").write_text(AHEAD + arc_files("arc-motion-tokens")["motion-tokens.ts"].replace('"motion/react"', '"framer-motion"'))
for n in ARC_PARTS:
    (ARC / n).mkdir(exist_ok=True)
    for fn, c in arc_files(n).items():
        c = c.replace('"motion/react"', '"framer-motion"').replace('"../motion-tokens"', '"../lib/motion-tokens"')
        (ARC / n / fn).write_text((AHEAD + c) if fn.endswith(".tsx") else c)
# the foundation's colour, type, space and motion tokens, scoped to .siso-arc (light, and dark under .dark or data-theme=dark)
fnd = arc_files("arc-foundation")["foundation.css"]
def block(sel):
    m = re.search(re.escape(sel) + r"\s*\{(.*?)\n\}", fnd, re.S); return m.group(1) if m else ""
light = block(":root"); dark = block(':root[data-theme="dark"]')
strip = lambda b: "\n".join(l for l in b.split("\n") if l.strip().startswith("--") and "color-scheme" not in l)
css = ".siso-arc {\n" + strip(light) + "\n}\n.dark .siso-arc, [data-theme=\"dark\"] .siso-arc {\n" + strip(dark) + "\n}\n"
(ARC / "tokens.ts").write_text("// Generated by bin/charts-package from the UI Arc foundation tokens. Do not edit.\nexport const arcTokensCss = " + json.dumps(css) + "\n")

# Arc fixes (Shaan, 16 Oct: "the text up top's kind of fucked", "the hover over is weird ... LiveDocs shows everything")
for n in ARC_PARTS:
    f = ARC / n / f"{n}.tsx"; t = f.read_text()
    # the screen-reader table showed its caption over the headline: a table cannot be clipped to 1px, a div around it can
    t = re.sub(r"<table className=\{styles\.srOnly\}>(.*?)</table>", r"<div className={styles.srOnly}><table>\1</table></div>", t, flags=re.S)
    if n == "activity-heatmap":
        old = "secondary: formats.short.format(date), value: count, anchor };"
        new = ("secondary: `${formats.short.format(date)} · level ${model.levels[index]} of 4 · ${Math.round((count / Math.max(...model.counts, 1)) * 100)}% of the busiest day"
               " · week total ${formats.number.format(model.counts.slice(Math.floor((index + model.lead) / 7) * 7 - model.lead < 0 ? 0 : Math.floor((index + model.lead) / 7) * 7 - model.lead, Math.floor((index + model.lead) / 7) * 7 - model.lead + 7).reduce((a: number, b: number) => a + b, 0))}`, value: count, anchor };")
        if t.count(old) != 1: raise SystemExit("heatmap tip patch does not apply once")
        t = t.replace(old, new)
    f.write_text(t)
    if n == "activity-heatmap":
        # the bubble's measured width came out 15px short of its last line ("week total 39" read "3"): never narrower than the text
        cf = ARC / n / f"{n}.module.css"; c = cf.read_text()
        o = ".tipBody { position: relative; display: block;"
        if o not in c: raise SystemExit("heatmap tipBody css not found")
        cf.write_text(c.replace(o, ".tipBody { position: relative; display: block; min-width: max-content;", 1))

# ---- Tweenly's radial (tweenly registry, in siso-ui-code) ----
TW = ROOT.parent / "siso-ui-code/r/tweenly"; TWO = OUT / "tweenly"; TWO.mkdir(exist_ok=True)
THEAD = "// uihub: siso:charts\n// Recoded from Tweenly (tweenly registry) into the SISO chart package: framer-motion in place of motion, ./chart-kit and ../lib/utils in place of the registry paths. Edit packages/siso-charts, not the registry copy.\n"
for name, out in [("chart-kit", "chart-kit.tsx"), ("chart-radial", "radial.tsx")]:
    c = json.loads((TW / f"{name}.json").read_text())["files"][0]["content"]
    c = c.replace('"motion/react"', '"framer-motion"').replace('"@/lib/utils"', '"../lib/utils"').replace('"@/registry/new-york/lib/chart-kit"', '"./chart-kit"')
    (TWO / out).write_text(THEAD + c)
print("wrote", sum(len(v) for v in PARTS.values()), "files to", OUT, "and", len(ARC_PARTS), "Arc charts")

#!/usr/bin/env python3
"""Fill every slot of SISO's map (node + variation) from the libraries Shaan kept, in his order (12 Oct 2026,
.agents/source/2026-10-12-library-walk.md, catalogue/base-set.json): the first library in the layer's order that has the
slot wins; inside one library, or when a later library's version has far more code, more code wins ("whatever is usually
more code tends to be better"). Charts: every chart from the chart libraries he liked is kept, not one per slot. Arc Pro and
every paid part (a registry's "gated") are reference only: noted under arc_pro/paid, never picked. Where Arc has the slot, Arc
wins outright (13 Oct, after the /vs pairs: "Arc is better for all of them"). Writes catalogue/base-v0.json and prints the summary.

  bin/base-pick"""
import json, os, glob, collections
HUB = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CODE = os.path.expanduser("~/SISO_Workspace/Great_Library_of_SISO/banks/siso-ui-code/r")
REG = {"arc": "uiarc"}
APP = ["arc", "shadcn-ui", "watermelon", "minidev", "reui", "kibo-ui", "diceui", "cubby-ui", "coss", "trophy-ui", "shadcnmaps", "plate", "remocn", "videocn", "emailcn", "slidecn", "billingsdk", "ecomcn", "formscn", "sureui", "quiz-ui", "openstatus", "ssych", "7ovr", "shadcncraft", "cnippet", "shadcn-ui-blocks", "shadcnblocks", "beste-ui", "uitripled", "react-aria", "intentui", "better-auth-ui", "gh-qareplus-better-auth-kit", "supabase", "gh-useautumn-pricecn", "audiocn", "niko-table", "dashboardblocks", "spaceui", "shadcnui-blocks", "catalogs", "gh-blinks44-moduix"]
SITE = ["arc", "tailark", "efferd", "watermelon", "minidev", "cnippet", "shadcn-ui-blocks", "shadcnblocks", "beste-ui", "uitripled", "trophy-ui", "shadcnmaps", "plate", "remocn", "videocn", "emailcn", "slidecn", "billingsdk", "ecomcn", "formscn", "sureui", "quiz-ui", "openstatus", "ssych", "7ovr", "shadcncraft", "shadcn-ui", "reui", "kibo-ui", "diceui", "cubby-ui", "coss", "better-auth-ui", "gh-qareplus-better-auth-kit", "supabase", "gh-useautumn-pricecn", "audiocn", "niko-table", "dashboardblocks", "spaceui", "shadcnui-blocks", "catalogs", "gh-blinks44-moduix"]
AGENT = ["ai-elements", "prompt-kit", "assistant-ui", "pastaui", "seamui", "tool-ui", "elevenlabs-ui", "arc", "watermelon", "minidev", "reui", "shadcn-ui", "kibo-ui", "diceui", "coss", "scrimui", "pipecat"]
CHARTS = ["arc", "evilcharts", "bklit", "shadcn-ui", "ssych"]
AGENT_NODES = {"component/message", "component/composer", "component/agent-parts", "section/chat", "page/chat-screen"}
O = json.load(open(f"{HUB}/catalogue/schema/ontology.json"))
V = json.load(open(f"{HUB}/catalogue/schema/variations.json"))
SITE_NODES = {f"section/{n['id']}" for n in O["sections"]["site"]} | {f"page/{n['id']}" for n in O["pages"]["site"]}
names = {}
for n in O["atoms"]: names[f"atom/{n['id']}"] = n["name"]
for g in O["components"]:
    for n in g["items"]: names[f"component/{n['id']}"] = n["name"]
for side in ("sections", "pages"):
    for l in O[side].values():
        for n in l: names[f"{side[:-1]}/{n['id']}"] = n["name"]
tier = {i["name"]: i["tier"] for i in json.load(open(f"{HUB}/sources/arc/raw/arc-catalog.json"))["items"]}
gated = set()  # parts a registry refused to hand over (paid: reui Pro, efferd, tailark): reference only, like Arc Pro
for f in glob.glob(f"{CODE}/*/_status.json"):
    lib = os.path.basename(os.path.dirname(f))
    lib = {v: k for k, v in REG.items()}.get(lib, lib)
    gated |= {f"{lib}:{n}" for n, st in json.load(open(f)).items() if st == "gated"}


def size(pid):
    lib, name = pid.split(":", 1)
    if lib == "shadcn-ui":
        fs = glob.glob(f"{HUB}/_reference/shadcn/*/{name}/**/*.tsx", recursive=True)
        return sum(os.path.getsize(f) for f in fs)
    f = f"{CODE}/{REG.get(lib, lib)}/{name.replace('/', '-')}.json"
    try:
        return sum(len(x.get("content") or "") for x in json.load(open(f)).get("files", []))
    except Exception:
        return 0


cand = collections.defaultdict(list)  # (node, variation) -> [(lib, id)]
pro = collections.defaultdict(list)
for f in glob.glob(f"{HUB}/catalogue/schema/lib-map/[!_]*.jsonl"):
    for l in open(f):
        o = json.loads(l)
        if not o.get("node"):
            continue
        lib = o["id"].split(":", 1)[0]
        k = (o["node"], o.get("variation") or "")
        if (lib == "arc" and tier.get(o["id"].split(":", 1)[1]) == "pro") or o["id"] in gated:
            pro[k].append(o["id"])
        else:
            cand[k].append(o["id"])
# one job listed twice on the map: the empty slot borrows the other slot's parts (and says so in same_as)
ALIAS = {("atom/image", "video-player"): ("component/player", "video-player"), ("atom/image", "audio-player"): ("component/player", "audio-player"),
         ("atom/image", "waveform"): ("component/player", "waveform-visualizer"), ("component/field", "tags-input"): ("component/tags", "basic-tag-input"),
         ("component/message", "tool-calls"): ("component/agent-parts", "tool-calls"), ("component/message", "reasoning-display"): ("component/agent-parts", "reasoning-display"),
         ("section/data-view", "board"): ("component/board", "kanban-drag-drop"), ("section/data-view", "date-picker"): ("component/calendar", "date-picker"),
         ("section/data-view", "calendar"): ("component/calendar", "event-calendar"), ("section/data-view", "feed"): ("component/timeline", "activity-timeline")}
# a page that is one section on a page borrows that section's parts (the section is where libraries file them)
for page, sec, pairs in [
    ("page/auth-page", "section/auth", {"auth-sign-in": "sign-in", "auth-sign-up": "sign-up", "auth-forgot-password": "forgot", "auth-magic-link": "magic-link"}),
    ("page/auth-screen", "section/auth", {"auth-sign-in-desktop": "sign-in", "auth-sign-in-mobile": "sign-in", "auth-sign-up": "sign-up", "auth-forgot-password": "forgot",
                                          "auth-two-factor": "2fa", "auth-magic-link": "magic-link", "auth-verification": "2fa", "auth-social-buttons": "social"}),
    ("page/onboarding-flow", "section/onboarding", {"onboarding-welcome": "welcome-screen", "onboarding-checklist": "checklist", "onboarding-stepper": "stepper", "onboarding-multi-step": "wizard"}),
    ("page/blog-index", "section/blog", {"blog-grid": "news-grid", "blog-featured": "featured-carousel", "blog-list": "list", "blog-categories": "topic-filter"}),
    ("page/pricing-page", "section/pricing", {"pricing-tiered": "tier-cards", "pricing-toggle": "billing-toggle", "pricing-comparison": "comparison-table"}),
    ("page/about-page", "section/about", {"about-timeline": "timeline", })]:
    for pv, sv in pairs.items():
        ALIAS[(page, pv)] = (sec, sv)
ALIAS.update({("component/code", "inline-code"): ("atom/text", "inline-code"), ("section/chat", "composer"): ("component/composer", "chat-composer"),
 ("section/filters", "search-field"): ("component/search", "search-field"),
              ("section/filters", "search-suggestions"): ("component/search", "with-suggestions"), ("section/filters", "command-style"): ("component/search", "command-style"),
              ("section/top-bar", "mega-menu"): ("section/nav", "mega-menu"), ("section/top-bar", "search"): ("section/nav", "search"),
              ("section/nav", "announcement-bar"): ("section/announcement", ""), ("atom/loader", "progress-bar"): ("atom/progress", "linear"),
              ("section/shell", "shell-mobile-tabs"): ("component/tabs", "bottom-tabs"), ("section/sidebar", "search"): ("section/nav", "search"),
              ("section/chat", "suggestions"): ("component/composer", "prompt-inputs"), ("page/about-page", "about-team"): ("section/team", "photo-grid"),
              ("section/showcase", "lightbox"): ("component/lightbox", "standard-lightbox")})
for k, src in ALIAS.items():
    if not cand.get(k):
        cand[k] = list(cand.get(src, []))
gapfill = collections.defaultdict(list)
for l in open(f"{HUB}/catalogue/schema/lib-map/_gapfill.jsonl"):
    o = json.loads(l)
    gapfill[(o["node"], o["variation"])].append(o["id"])
out, summary = [], collections.Counter()
for node in names:
    vs = [x["id"] for x in V.get(node, {}).get("variations", [])]
    for v in [""] + vs:
        k = (node, v)
        order = CHARTS if node == "component/chart" else AGENT if node in AGENT_NODES else SITE if node in SITE_NODES else APP
        c = [(i, size(i)) for i in cand.get(k, []) if i.split(":")[0] in order]
        c.sort(key=lambda x: (order.index(x[0].split(":")[0]), -x[1]))
        if not c and k[1]:  # last resort: a part found for this slot anywhere in the code bank (lib-map/_gapfill.jsonl, judged best first)
            c = [(i, size(i)) for i in gapfill.get(k, [])]
        if not v and not c:
            continue  # the node's plain slot is optional when its variations are filled
        row = {"node": node, "name": names[node], "variation": v or None, "vname": next((x["name"] for x in V[node]["variations"] if x["id"] == v), None) if v else None}
        if node == "component/chart":
            row["take_all"] = [i for i, _ in c]
            row["pick"] = c[0][0] if c else None
        else:
            row["pick"] = c[0][0] if c else None
            row["pick_code"] = c[0][1] if c else 0
            row["also"] = [{"id": i, "code": s} for i, s in c[1:6]]
            row["dupes"] = len(c) - 1 if c else 0
            big = [i for i, s in c[1:] if c and s >= 2 * max(c[0][1], 1) and s - c[0][1] > 3000]
            if big and not row["pick"].startswith("arc:"):  # 13 Oct, /vs: "Arc is better for all of them"
                row["closer_look"] = big[:3]
        if k in ALIAS and row["pick"]:
            row["same_as"] = "/".join(x for x in ALIAS[k] if x)
        if pro.get(k):
            row["paid"] = pro[k]
        out.append(row)
json.dump(out, open(f"{HUB}/catalogue/base-v0.json", "w"), indent=1, ensure_ascii=False)
fill = [r for r in out if r["pick"]]
print(f"slots {len(out)}, filled {len(fill)}, empty {len(out) - len(fill)} (of which only a paid version exists for {sum(1 for r in out if not r['pick'] and r.get('paid'))})")
print("picks by library:", collections.Counter(r["pick"].split(":")[0] for r in fill).most_common())
print("duplicates behind picks:", sum(r.get("dupes", 0) for r in out), "; closer looks:", sum(1 for r in out if r.get("closer_look")))

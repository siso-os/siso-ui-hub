#!/usr/bin/env python3
"""peek: facts and a trimmed look at named components in one project, read from git at the census ref (no checkout).
Imports fold to one line; blank lines and comments drop. For judging swap candidates without opening whole files.
  peek <project> <Name|path> [...] [--lines N]     (N default 45; 0 = facts only)"""
import json, os, re, subprocess, sys
HUB = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))  # the siso-ui-hub repo root
H = HUB
a = sys.argv[1:]; n = int(a[a.index("--lines") + 1]) if "--lines" in a else 45
if "--lines" in a: i = a.index("--lines"); a = a[:i] + a[i + 2:]
proj, want = a[0], a[1:]
c = json.load(open(f"{H}/inventory/{proj}.census.json"))
if c.get("namesOnly"): sys.exit(f"{proj} is names-only: code is never read")
inv = {json.loads(l)["file"]: json.loads(l) for l in open(f"{H}/inventory/{proj}.jsonl")}
for w in want:
    rows = [r for r in c["rows"] if r["name"] == w or r["file"].endswith(w)]
    for r in rows:
        v = inv.get(r["file"], {})
        print(f"\n### {r['name']}  {r['file'].replace(c['prefix'], '')}  loc {r['loc']} | pages {v.get('pages')} {'shell ' if v.get('shell') else ''}| "
              f"{v.get('grade')} ({'; '.join(v.get('why') or [])}) | a11y {r.get('a11y')} reduced {r.get('reduced')} hex {r.get('hex')} "
              f"divClick {r.get('divClick')} pills {r.get('pills')} | libs {','.join(r['libs']) or '-'} ui {','.join(r['shadcn']) or '-'} | "
              f"{r['commits']} commits over {r['days']} days, last {r['last']} | importedBy {len(r['importedBy'])}")
        if not n: continue
        t = subprocess.run(["git", "-C", c["repo"], "show", f"{c['ref']}:{r['file']}"], capture_output=True, text=True).stdout
        t = re.sub(r"/\*.*?\*/", "", t, flags=re.S)
        lines = [l.rstrip() for l in t.splitlines() if l.strip() and not l.strip().startswith("//")]
        imps = [l for l in lines if l.startswith("import ")]
        body = [l for l in lines if not l.startswith("import ") and not re.match(r"^\s*[\w$]+,?$|^\s*\}\s*from", l)]
        print("imports:", "; ".join(re.sub(r"^import\s+|\s*;$", "", l)[:70] for l in imps)[:400])
        for l in body[:n]: print(l[:150])
        if len(body) > n: print(f"... {len(body) - n} more lines")

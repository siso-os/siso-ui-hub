{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "actionist.affine.block-manifest.v1",
  "title": "Actionist reusable block manifest",
  "type": "object",
  "required": [
    "schema_version",
    "block_id",
    "capability_id",
    "reuse",
    "records",
    "source_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "actionist.block-manifest.v1"
    },
    "block_id": {
      "type": "string",
      "pattern": "^actionist/[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capability_id": {
      "type": "string"
    },
    "reuse": {
      "type": "object",
      "required": ["shape", "rights_exposure", "mount_profile", "mount_topology", "binding_class"],
      "properties": {
        "shape": {
        "enum": ["absorbed_native", "assimilated_package", "preserved_framed", "preserved_identity_erased", "intact_service"]
        },
        "rights_exposure": {
          "enum": ["none_network_only", "host_code", "donor_code", "mixed"]
        },
        "mount_profile": {
          "type": "string"
        },
        "mount_topology": {
          "enum": ["same_document", "iframe_same_origin", "iframe_cross_origin", "service_only"]
        },
        "binding_class": {
          "enum": ["B1", "B2", "B3", "B4", "B5"]
        }
      },
      "additionalProperties": true
    },
    "records": {
      "type": "object",
      "required": ["capability", "packaging", "host_requirements", "binding_plan", "qualification", "registry", "release"],
      "additionalProperties": {
        "type": "string",
        "pattern": "^records/[A-Za-z0-9._-]+\\.json$"
      }
    },
    "source_boundary": {
      "type": "object",
      "required": ["source_copied", "donor_repository_vendored", "secrets_embedded", "absolute_client_paths_embedded", "deployment_performed"],
      "properties": {
        "source_copied": {"const": false},
        "donor_repository_vendored": {"const": false},
        "secrets_embedded": {"const": false},
        "absolute_client_paths_embedded": {"const": false},
        "deployment_performed": {"const": false}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

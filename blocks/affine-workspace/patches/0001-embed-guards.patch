@@ -0,0 +1,31 @@
+const EMBED_CONFIG_STORAGE_KEY = 'siso:embedded-config';
+
+type StoredEmbedConfig = {
+  embedded?: boolean;
+  hostOrigin?: string | null;
+};
+
+function hasTrustedHostOrigin(value: string | null) {
+  if (!value || !URL.canParse(value)) return false;
+  const protocol = new URL(value).protocol;
+  return protocol === 'http:' || protocol === 'https:';
+}
+
+export function isSisoEmbedded() {
+  try {
+    const url = new URL(window.location.href);
+    if (
+      url.searchParams.get('siso_embedded') === '1' &&
+      hasTrustedHostOrigin(url.searchParams.get('siso_host_origin'))
+    ) {
+      return true;
+    }
+
+    const stored = globalThis.sessionStorage?.getItem(EMBED_CONFIG_STORAGE_KEY);
+    if (!stored) return false;
+    const config = JSON.parse(stored) as StoredEmbedConfig;
+    return config.embedded === true && hasTrustedHostOrigin(config.hostOrigin ?? null);
+  } catch {
+    return false;
+  }
+}


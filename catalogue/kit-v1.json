{
 "version": "0.1-draft",
 "date": "2026-10-14",
 "rules": {
  "layers": [
   "foundation",
   "atom",
   "control",
   "widget",
   "section",
   "page",
   "shell"
  ],
  "sets": [
   "motion",
   "charts",
   "icons"
  ],
  "layer_meaning": {
   "foundation": "tokens: colour, type, space, radius, motion timing",
   "atom": "one element, no inner layout: button, input, badge",
   "control": "atoms joined to do one job with data: select, date picker, tabs, table",
   "widget": "a control bound to one data shape and drawn in the widget frame (ADR 0004): stat, chart card, inbox",
   "section": "a band of a page (ADR 0003): hero, pricing, kpis, data view",
   "page": "bands in order for one job: dashboard, settings, pricing page",
   "shell": "what outlives pages: sidebar, top bar, command bar, the frame"
  },
  "kind_rule": "A new kind only when the interaction or the data shape differs. Looks, sizes and states are props of the kind's default, never separate parts.",
  "states_rule": "State, edge and platform variations from schema/variations.json are requirements the default must meet (loading, error, disabled, keyboard, reduced motion), not parts.",
  "pick_rule": "One default and one backup per kind. Arc is the default wherever it has the kind; shadcn (new-york-v4) is the usual backup; other libraries only fill a kind neither has. Shaan's verdicts override.",
  "explore": "Every other part stays in /kit as Explore, reachable from its kind via 'show alternatives'.",
  "assets_note": "Icons, images and other files are assets (their own layer), not atoms (Shaan 14 Oct)."
 },

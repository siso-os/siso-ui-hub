{
 "about": "SISO's UI ontology (11 Oct 2026). Shaan: 'break down every single atomic type that you would need for any landing page ... any atom that comes from that component type ... so the infinite scales of creativity still has a base to come from ... well reasoned and will stand the test of time of 10-20 years'. Every part sits at one SCALE (how much of a screen it is) and does one JOB. Look, motion, content and use case are variations on it, never new places. 'cats' ties a node to the library's categories; the clean types under a category are its structural variations.",
 "scales": [
  {
   "id": "foundation",
   "name": "Foundations",
   "job": "the decisions every part inherits: colour, type, space, radius, elevation, motion timing",
   "cats": [
    "themes/theme",
    "themes/style"
   ]
  },
  {
   "id": "atom",
   "name": "Atoms",
   "job": "one element with one job that cannot be split further"
  },
  {
   "id": "component",
   "name": "Components",
   "job": "atoms combined to do one job: pick a date, show a record, ask a question"
  },
  {
   "id": "section",
   "name": "Sections",
   "job": "a full-width band of a page (site) or a region of a screen (app) with one purpose"
  },
  {
   "id": "page",
   "name": "Pages and screens",
   "job": "one whole view a person lands on, made of sections",
   "cats": [
    "pages/templates"
   ]
  },
  {
   "id": "surface",
   "name": "Surfaces",
   "job": "a whole product: a shell plus its pages"
  }
 ],
 "variation_axes": {
  "type": "structure: how it is built or laid out (the clean types, e.g. sidebar: grouped sections, collapsible icon rail, nested tree)",
  "look": "foundations applied: minimal, dark, glass, editorial, 3d, brutalist, neon-glow ...",
  "motion": "none, micro, entrance, scroll, loop, interactive, 3d",
  "density": "compact, comfortable, spacious",
  "content": "what fills it: text, numbers, media, people, code",
  "use": "the job in a domain (fits: saas, ai, commerce, fintech ...); a WIDGET is a component specialised for one use"
 },
 "cross_cutting": [
  {
   "id": "effects",
   "name": "Motion and effects",
   "job": "applied to any scale to animate or decorate it",
   "cats": [
    "motion/text-effect",
    "motion/background",
    "motion/cursor",
    "motion/shader",
    "motion/number-ticker",
    "motion/marquee",
    "motion/gradient",
    "motion/globe",
    "motion/ascii",
    "motion/border",
    "motion/tilt-3d"
   ]
  },
  {
   "id": "assets",
   "name": "Assets",
   "job": "what a design uses rather than what it is made of: icons, logos, images, illustrations, fonts, sounds",
   "cats": [
    "assets"
   ]
  },
  {
   "id": "behaviour",
   "name": "Behaviour",
   "job": "code with no look: hooks and utilities that make parts work",
   "cats": [
    "lib/hook",
    "lib/utility"
   ]
  }
 ],

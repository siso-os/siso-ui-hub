        { "id": "site-frame", "name": "Site frame", "job": "the chrome around a site: top nav and footer", "kinds": [{ "key": "shell/site-frame", "name": "Site frame", "job": "top nav, page, footer; one per product, its icon and colour" }] },
        { "id": "native-frame", "name": "Native app frame", "job": "a phone app's tab bar and stack", "kinds": [{ "key": "shell/native-frame", "name": "Native app frame", "job": "tab bar, screen stack, sheets" }] }
      ]
    },
    {
      "id": "style", "name": "Style", "scale": "look",
      "families": [
        { "id": "themes", "name": "Themes", "job": "colour, type and radius together", "kinds": ["look/theme", "look/style", { "key": "look/tokens", "name": "Tokens", "job": "the kit's colours, type, radii and motion; change one, see every part it touches" }] },
        { "id": "text-motion", "name": "Text and numbers", "job": "words and figures that move", "kinds": ["look/text-effect", "look/number-ticker", "look/ascii"] },
        { "id": "backgrounds", "name": "Backgrounds", "job": "what sits behind", "kinds": ["look/background", "look/shader", "look/gradient", "look/globe"] },
        { "id": "interaction", "name": "Interaction", "job": "motion that answers the person", "kinds": ["look/cursor", "look/tilt-3d", "look/border", "look/marquee"] }

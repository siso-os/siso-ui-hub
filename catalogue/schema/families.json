    },
    {
      "id": "assets", "name": "Assets", "scale": "asset",
      "families": [
        { "id": "icons", "name": "Icons", "job": "icon sets; the Icon atom draws them", "kinds": ["atom/icon"] },
        { "id": "brand", "name": "Brand", "job": "logos and fonts", "kinds": ["asset/logo", "asset/font"] },
        { "id": "images", "name": "Images", "job": "art, shapes, OG images, avatars, flags", "kinds": ["asset/illustration", "asset/shape", "asset/og-image", "asset/avatar", "asset/flag"] },
        { "id": "sound", "name": "Sound", "job": "clicks, chimes, ambience", "kinds": ["asset/sound"] }
      ]
    }
  ]

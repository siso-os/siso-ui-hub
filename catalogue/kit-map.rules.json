{
 "frames": {
  "flow": {
   "show": "storyboard",
   "why": "several screens in order, toward one goal; seen as a strip of screens you click through",
   "families": {
    "account": [
     {
      "kind": "sign-up-flow",
      "job": "new account: details, verify, welcome",
      "re": "sign.?up.?flow|registration.?flow|verify.?email",
      "made_of": [
       "auth-page",
       "otp",
       "onboarding-flow"
      ]
     },
     {
      "kind": "sign-in-flow",
      "job": "sign in, 2FA, forgot password",
      "re": "two.?factor|2fa|magic.?link|sign.?in.?flow",
      "made_of": [
       "auth-page",
       "otp",
       "reset-password-flow"
      ]
     },
     {
      "kind": "reset-password-flow",
      "job": "forgot, email, new password",
      "re": "forgot|reset.?password|recover",
      "made_of": [
       "auth-card",
       "password"
      ]
     },
     {
      "kind": "onboarding-flow",
      "job": "first run: set up, invite, tour",
      "re": "onboard|welcome.?flow|getting.?started|tour",
      "made_of": [
       "stepper",
       "form",
       "choice-card"
      ]
     },
     {
      "kind": "invite-flow",
      "job": "bring a teammate in",
      "re": "invite",
      "made_of": [
       "dialog",
       "tag-input",
       "select"
      ]
     }
    ],
    "money": [
     {
      "kind": "checkout-flow",
      "job": "cart, details, pay, done",
      "re": "checkout|payment.?flow|cart",
      "made_of": [
       "form",
       "stepper",
       "phone-money"
      ]
     },
     {
      "kind": "upgrade-flow",
      "job": "pick a plan and pay",
      "re": "upgrade|plan.?select|subscribe.?flow",
      "made_of": [
       "pricing",
       "segmented",
       "checkout-flow"
      ]
     }
    ],
    "work": [
     {
      "kind": "create-flow",
      "job": "make a new thing in steps",
      "re": "wizard|multi.?step|create.?flow|new.?project",
      "made_of": [
       "stepper",
       "form",
       "dialog"
      ]
     },
     {
      "kind": "import-flow",
      "job": "bring data in: upload, map, check",
      "re": "import|csv|mapping",

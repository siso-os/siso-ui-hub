{
  "name": "@siso/navigation",
  "version": "0.4.1",
  "description": "Router-free SISO navigation, disclosure lists, rails and page navigation.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles.css",
    "./inventory.json": "./inventory.json",
    "./hub.css": "./hub.css",
    "./source-provenance.json": "./source-provenance.json",
    "./agent-base": {
      "types": "./src/agent-base/index.ts",
      "import": "./src/agent-base/index.ts",
      "default": "./src/agent-base/index.ts"
    },
    "./agent-base.css": "./agent-base.css"
  },
  "files": [
    "src",
    "styles.css",
    "README.md",
    "LICENSE",
    "NOTICE",
    "inventory.json",
    "hub.css",
    "assets",
    "source-provenance.json",
    "agent-base.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0 || ^1.0.0",
    "framer-motion": "^12.0.0",
    "motion": "^12.0.0 || ^14.0.0"
  },
  "dependencies": {
    "@siso/shells": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  }
}

#!/usr/bin/env python3
"""A picture of every icon, logo and flag, drawn from its own code.

Icons are code, not pages: a page of 1,280 icons has no one icon to photograph, so bin/shoot leaves them. This reads
each part's SVG out of its file (React TSX, motion components, Vue templates), turns the JSX into plain SVG, keeps only
drawing elements and attributes (no scripts, handlers, styles or outside links: the hub shows these on his signed-in
site), paints currentColor a mid grey that reads on dark and light, and writes
~/SISO_Workspace/_data/ui-hub/thumbs/<registry>/<part>.svg beside bin/shoot's pictures, where the UI Hub finds it.

  bin/icons                  # every icon, logo and flag part whose code is on disk (git sparse-checkout add '/r/<reg>/*')
  bin/icons --only keyline
  bin/icons --force          # redraw ones already drawn

Shaan, 10 Oct: "get maybe all of these components downloaded ... so they can be viewed on the thing".
"""
import argparse, collections, json, os, re, sys
import xml.etree.ElementTree as ET

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.environ.get("UI_THUMBS", os.path.expanduser("~/SISO_Workspace/_data/ui-hub/thumbs"))
GREY = "#a1a1aa"
SVGNS = "http://www.w3.org/2000/svg"
KINDS = ("assets/icon", "assets/logo", "assets/flag")
TAGS = {"svg", "g", "path", "circle", "ellipse", "line", "polyline", "polygon", "rect", "defs", "lineargradient",
        "radialgradient", "stop", "clippath", "mask", "use", "symbol", "pattern", "title", "filter", "fegaussianblur",
        "feoffset", "feblend", "fecolormatrix", "fecomposite", "feflood", "femerge", "femergenode", "femorphology",
        "fedropshadow", "text", "tspan"}
CAMEL = {"viewBox", "preserveAspectRatio", "gradientUnits", "gradientTransform", "patternUnits", "patternContentUnits",
         "patternTransform", "clipPathUnits", "maskUnits", "maskContentUnits", "markerWidth", "markerHeight", "refX", "refY",
         "stdDeviation", "baseFrequency", "numOctaves", "filterUnits", "primitiveUnits", "textLength", "lengthAdjust",
         "startOffset", "spreadMethod", "pathLength", "edgeMode", "in2", "floodColor", "floodOpacity"}
DROP_ATTR = re.compile(r"^(class|classname|style|key|ref|role|focusable|tabindex|id-?prefix|on\w*|data-.*|aria-.*|v-.*|xmlns:.*)$", re.I)


def key_of(name):
    return "/".join(re.sub(r"[^A-Za-z0-9._@+-]", "_", p) for p in name.split("/") if p not in ("", ".", ".."))


def braced(s, i):
    """the index just past the {...} that starts at s[i], nested braces and quoted strings allowed for"""
    depth, q = 0, None
    while i < len(s):
        c = s[i]
        if q:
            if c == "\\": i += 1
            elif c == q: q = None
        elif c in "\"'`": q = c
        elif c == "{": depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0: return i + 1
        i += 1
    return len(s)


def value_of(expr):
    """a JSX attribute's {expression} as SVG text, or None to drop the attribute"""
    e = expr.strip()
    if re.fullmatch(r"-?\d+(\.\d+)?", e): return e
    m = re.fullmatch(r"([\"'])(.*)\1", e, re.S) or re.fullmatch(r"`([^`$]*)`", e)
    if m: return m.group(m.lastindex)
    if re.fullmatch(r"(props\.)?size", e): return "24"
    if re.fullmatch(r"(props\.)?(strokeWidth|stroke_width)", e): return "2"
    if re.fullmatch(r"(props\.)?color", e): return "currentColor"
    return None


def jsx_to_svg(src):
    m = re.search(r"<(motion\.svg|m\.svg|svg)\b", src)
    if not m: return None
    end = src.find(f"</{m.group(1)}>", m.start())
    if end < 0: return None
    s = src[m.start(): end + len(m.group(1)) + 3]
    s = re.sub(r"\{/\*.*?\*/\}", "", s, flags=re.S)
    s = re.sub(r"<(/?)(?:motion\.|m\.)(\w+)", r"<\1\2", s)
    out, i = [], 0
    while i < len(s):
        c = s[i]
        if c == "{":  # a spread or a child expression: dropped
            i = braced(s, i); continue
        if c == "=" and i + 1 < len(s) and s[i + 1] == "{":
            j = braced(s, i + 1)
            v = value_of(s[i + 2: j - 1])
            if v is None:  # drop the attribute name already written
                k = len(out) - 1
                while k >= 0 and re.match(r"[\w:.-]", out[k]): k -= 1
                del out[k + 1:]
            else:
                out.append('="' + v.replace('"', "&quot;") + '"')
            i = j; continue
        out.append(c); i += 1
    s = "".join(out)
    # Vue: :attr="expr" is bound (kept when it is a plain number or string), v-*/@* are behaviour
    s = re.sub(r'\s:([\w-]+)="(-?\d+(?:\.\d+)?)"', r' \1="\2"', s)
    s = re.sub(r'\s(?::|@|v-)[\w:.-]+(="[^"]*")?', "", s)
    return s


def clean(svg_text):
    """parse, keep drawing only, grey for currentColor; None when it is not a drawable SVG"""
    t = re.sub(r"\s(xmlns(:\w+)?)=\"[^\"]*\"", "", svg_text)
    t = t.replace("xlink:href", "href").replace("&nbsp;", " ")
    try:
        root = ET.fromstring(t)
    except ET.ParseError:
        return None
    if root.tag.lower() != "svg": return None
    def walk(el):
        for child in list(el):
            if child.tag.lower() not in TAGS: el.remove(child)
            else: walk(child)
        for a in list(el.attrib):
            v = el.attrib[a]
            name = a if a in CAMEL else re.sub(r"([a-z0-9])([A-Z])", r"\1-\2", a).lower()
            del el.attrib[a]
            if DROP_ATTR.match(a) or DROP_ATTR.match(name): continue
            if name == "href" and not v.startswith("#"): continue
            if "url(" in v and not re.fullmatch(r"url\(#[\w-]+\)", v.strip()): continue
            el.attrib[name] = v.replace("currentColor", GREY).replace("currentcolor", GREY)
    walk(root)
    if not any(e.tag.lower() in ("path", "circle", "ellipse", "line", "polyline", "polygon", "rect", "use", "text") for e in root.iter()):
        return None
    vb = (root.attrib.get("viewBox") or "").replace(",", " ").split()
    if len(vb) != 4:
        w, h = root.attrib.get("width", "24"), root.attrib.get("height", "24")
        if not (re.fullmatch(r"\d+(\.\d+)?", w) and re.fullmatch(r"\d+(\.\d+)?", h)): w, h = "24", "24"
        root.attrib["viewBox"] = f"0 0 {w} {h}"; vb = ["0", "0", w, h]
    w, h = float(vb[2]) or 24, float(vb[3]) or 24
    k = 96 / max(w, h)
    root.attrib["width"], root.attrib["height"] = f"{w * k:.0f}", f"{h * k:.0f}"
    # nothing says how to paint it: the default would be black, unreadable on the dark hub
    if not re.search(r"\b(fill|stroke)=", ET.tostring(root, encoding="unicode")):
        root.attrib["fill"] = GREY
    root.attrib["xmlns"] = SVGNS
    return ET.tostring(root, encoding="unicode", short_empty_elements=True)


def fetch_flag(code):
    import urllib.request
    url = f"https://cdn.jsdelivr.net/npm/flag-icons@7.5.0/flags/4x3/{code}.svg"
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "siso-ui-code bin/icons"}), timeout=20) as r:
            return clean(r.read().decode("utf-8", "ignore"))
    except Exception:
        return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--only", default="")
    ap.add_argument("--force", action="store_true")
    a = ap.parse_args()
    only = {s for s in a.only.split(",") if s}
    sort = {}
    for l in open(os.path.join(ROOT, "classified.jsonl")):
        r = json.loads(l)
        if r["cat"].startswith(KINDS) and not r.get("base"): sort[r["id"]] = r
    n = collections.Counter()
    for l in open(os.path.join(ROOT, "catalog.jsonl")):
        x = json.loads(l)
        if x["id"] not in sort or (only and x["reg"] not in only): continue
        code = os.path.join(ROOT, x.get("code") or "")
        if not x.get("code") or not os.path.exists(code):
            n["no code on disk"] += 1; continue
        dst = os.path.join(OUT, x["reg"], key_of(x["name"]) + ".svg")
        if os.path.exists(dst) and not a.force:
            n["had"] += 1; continue
        item = json.load(open(code))
        svg = None
        flag = re.search(r'<Flag code="([a-z]{2}(?:-[a-z]+)?)"', json.dumps(item).replace('\\"', '"'))
        if flag:  # flagcn draws each flag from flag-icons (MIT) on jsDelivr: the same file its component loads
            svg = fetch_flag(flag.group(1))
        for f in [] if svg else item.get("files") or []:
            raw = f.get("content") or ""
            svg = clean(raw) if raw.lstrip().startswith("<svg") else (jsx_to_svg(raw) and clean(jsx_to_svg(raw)))
            if svg: break
        if not svg:
            n[f"no svg: {x['reg']}"] += 1; continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        open(dst, "w").write(svg)
        n["drawn"] += 1
    print(dict(n))


if __name__ == "__main__":
    main()

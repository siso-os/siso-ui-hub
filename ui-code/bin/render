ENTRY = """import * as M from "{main}"
import {{ createRoot }} from "react-dom/client"
import {{ Component, createElement }} from "react"
class Guard extends Component<any, any> {{
  state = {{ e: null }}
  static getDerivedStateFromError(e: any) {{ return {{ e }} }}
  componentDidCatch(e: any) {{ (window as any).__err = String(e && e.message || e) }}
  render() {{ return this.state.e ? null : this.props.children }}
}}
const m: any = M
const C = (typeof m.default === "function" || (m.default && m.default.$$typeof)) ? m.default
  : (Object.entries(m).find(([k, v]: any) => /^[A-Z]/.test(k) && (typeof v === "function" || (v && v.$$typeof))) || [])[1]
;(window as any).__picked = !!C
const root = createRoot(document.getElementById("root")!)
let n = 0
const draw = (props: any) => root.render(createElement(Guard, {{ key: n++ }}, C ? createElement(C as any, props) : null))
draw(null)
// a part that needs content (a heading, a badge, a highlight) draws nothing alone: bin/render redraws it with sample props
;(window as any).__redraw = (props: any) => {{ (window as any).__err = null; draw(props) }}

#!/usr/bin/env python3
"""Every part's detailed type: what it is in a sentence, its level, pattern, the slots it fills, look, motion, fits and a
1-5 rating (types/README.md, words in types/vocab.json). Readers write labels; this makes their batches, checks their
work and merges it.

  bin/types batches [--size 200]   # the parts still to read -> $TYPES_WORK/batches/bNNN.jsonl (cards) + sheets/bNNN-K.jpg
  bin/types batches --prefix n --match '^(?!gh-)'   # a later pull's parts get their own letter
  bin/types check                  # the labels against the vocabulary: counts, bad values, coverage
  bin/types merge                  # labels -> types.jsonl, one row per part; variants and copies take their base's type
"""
import argparse, collections, glob, json, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
WORK = os.environ.get("TYPES_WORK", os.path.expanduser("~/SISO_Workspace/_data/ui-types"))
THUMBS = os.environ.get("UI_THUMBS", os.path.expanduser("~/SISO_Workspace/_data/ui-hub/thumbs"))
VOCAB = json.load(open(os.path.join(ROOT, "types/vocab.json")))
# what Shaan builds first: whole sections and screens, then the parts inside them, then the rest
ORDER = ["marketing", "pages", "layout", "flows", "navigation", "ai-agent", "data-display/card", "motion/background", "motion/shader",
         "data-viz", "data-display/table", "data-display/stat", "data-display/list", "media", "overlays", "motion", "data-display",
         "actions", "inputs", "status", "themes", "other", "lib"]


def rows(path):
    return [json.loads(l) for l in open(path) if l.strip()]


def labels():
    """id -> label; the hand-read set wins over readers', a later file over an earlier; a line a reader is still writing
    is skipped"""
    out = {}
    files = sorted(glob.glob(os.path.join(ROOT, "types/labels/*.jsonl")), key=lambda p: (os.path.basename(p).startswith("hand"), p))
    for p in files:
        for l in open(p):
            try:
                r = json.loads(l) if l.strip() else {}
            except ValueError:
                continue
            if isinstance(r, dict) and r.get("id"):
                out[r["id"]] = r
    return out


def to_type():
    cls = rows(os.path.join(ROOT, "classified.jsonl"))
    copy = {}
    for r in rows(os.path.join(ROOT, "dupes.jsonl")):
        copy.update({i: r["original"] for i in r["ids"] if i != r["original"]})
    todo = [r for r in cls if not r.get("base") and not r.get("junk") and not r["cat"].startswith("assets/") and r["id"] not in copy]
    rank = lambda c: next((n for n, o in enumerate(ORDER) if c == o or c.startswith(o + "/")), len(ORDER))
    return sorted(todo, key=lambda r: (rank(r["cat"]), r["cat"], r["id"])), cls, copy


def batches(size, prefix="b", match=None, held=False, ids=None):
    from PIL import Image, ImageDraw, ImageFont
    sys.path.insert(0, os.path.join(ROOT, "bin"))
    import importlib.machinery, importlib.util
    spec = importlib.util.spec_from_loader("typecard", importlib.machinery.SourceFileLoader("typecard", os.path.join(ROOT, "bin/typecard")))
    tc = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(tc)
    done = labels()
    todo, cls, _ = to_type()
    todo = [r for r in todo if r["id"] not in done and (not match or re.search(match, r["id"]))]
    if ids:
        want = set(open(ids).read().split())
        todo = [r for r in todo if r["id"] in want]
    cat = {r["id"]: r for r in rows(os.path.join(ROOT, "catalog.jsonl"))}
    if held:  # a part whose code we do not hold and have no picture of gives a reader nothing to look at
        todo = [r for r in todo if (cat.get(r["id"]) or {}).get("code")]
    clsd = {r["id"]: r for r in cls}
    for d in ("batches", "sheets"):
        os.makedirs(os.path.join(WORK, d), exist_ok=True)
    # a later pull's parts get their own letter (n001 ...); a letter's later waves carry on its numbers, and a part already
    # in a batch waiting for its reader is not batched again
    old = glob.glob(os.path.join(WORK, f"batches/{prefix}[0-9]*.jsonl"))
    start = max((int(re.sub(r"\D", "", os.path.basename(p))) for p in old), default=0)
    waiting = {json.loads(l)["id"] for p in glob.glob(os.path.join(WORK, "batches/[a-z][0-9]*.jsonl")) for l in open(p) if l.strip()}
    todo = [r for r in todo if r["id"] not in waiting]
    # a batch keeps to one category where it can (a reader settles its patterns once); a small one shares
    groups, cur = [], []
    for r in todo:
        if len(cur) >= size or (cur and cur[-1]["cat"] != r["cat"] and len(cur) >= size * 0.6):
            groups.append(cur)
            cur = []
        cur.append(r)
    if cur:
        groups.append(cur)
    font = ImageFont.load_default(size=22)
    W, H, COLS, PER = 360, 270, 5, 20
    index = []
    for b, grp in enumerate(groups, 1):
        name = f"{prefix}{start + b:03d}"
        cards, pics = [], []
        for n, r in enumerate(grp, 1):
            row = cat.get(r["id"]) or {"id": r["id"], "reg": r["id"].rsplit("/", 1)[0], "name": r["id"].rsplit("/", 1)[1]}
            c = tc.card(row, clsd)
            c = {"n": n, **c}
            if c.get("picture"):
                pics.append((n, c.pop("picture")))
                k = (len(pics) - 1) // PER + 1
                c["sheet"] = f"{name}-{k}.jpg tile {n}"
            cards.append(c)
        with open(os.path.join(WORK, "batches", name + ".jsonl"), "w") as f:
            f.writelines(json.dumps(c, ensure_ascii=False) + "\n" for c in cards)
        for k in range(0, len(pics), PER):
            chunk = pics[k:k + PER]
            rows_ = (len(chunk) + COLS - 1) // COLS
            # a mid-grey sheet and a light frame round each picture: a dark-mode drawing on a dark sheet read as a blank tile
            # (11 Oct: 327 parts rated down for it)
            sheet = Image.new("RGB", (W * COLS, (H + 28) * rows_), (112, 112, 120))
            d = ImageDraw.Draw(sheet)
            for j, (n, p) in enumerate(chunk):
                x, y = (j % COLS) * W, (j // COLS) * (H + 28)
                d.text((x + 6, y + 2), str(n), fill=(255, 200, 60), font=font)
                try:
                    im = Image.open(p).convert("RGB")
                    im.thumbnail((W - 6, H - 2))
                    sheet.paste(im, (x + 3, y + 28))
                    d.rectangle((x + 2, y + 27, x + 3 + im.width, y + 28 + im.height), outline=(235, 235, 240), width=1)
                except Exception:
                    d.text((x + 40, y + 120), "unreadable", fill=(220, 80, 80), font=font)
            sheet.save(os.path.join(WORK, "sheets", f"{name}-{k // PER + 1}.jpg"), quality=78)
        index.append({"batch": name, "parts": len(cards), "pictures": len(pics), "cats": dict(collections.Counter(r["cat"] for r in grp))})
        print(name, len(cards), len(pics), list(index[-1]["cats"])[:3], flush=True)
    with open(os.path.join(WORK, "batches/index.jsonl" if prefix == "b" else f"batches/index-{prefix}.jsonl"), "a" if start else "w") as f:
        f.writelines(json.dumps(i) + "\n" for i in index)
    print(len(groups), "batches,", sum(len(g) for g in groups), "parts")


SLOTS = {f"{s}:{x}" for s, xs in VOCAB["slots"].items() for x in xs}
CATS = None


def problems(r):
    global CATS
    if CATS is None:
        CATS = {x["category"] for x in json.load(open(os.path.join(ROOT, "taxonomy.json")))["categories"]}
    bad = []
    if r.get("level") not in VOCAB["levels"]:
        bad.append("level")
    if r.get("motion") not in VOCAB["motion"]:
        bad.append("motion")
    if not isinstance(r.get("rating"), int) or not 1 <= r["rating"] <= 5:
        bad.append("rating")
    if r.get("cat") not in CATS:
        bad.append("cat")
    if any(s not in SLOTS for s in r.get("slots") or []):
        bad.append("slots")
    if any(x not in VOCAB["looks"] for x in r.get("look") or []):
        bad.append("look")
    if any(x not in VOCAB["fits"] for x in r.get("fits") or []):
        bad.append("fits")
    if not r.get("what") or not r.get("pattern"):
        bad.append("what/pattern")
    return bad


def check():
    lab = labels()
    todo, _, _ = to_type()
    ids = {r["id"] for r in todo}
    bad = collections.Counter()
    for r in lab.values():
        bad.update(problems(r))
    print(f"labelled {len(lab)} ({len(ids & set(lab))} of {len(ids)} to type); problems: {dict(bad) or 'none'}")
    print("levels", collections.Counter(r.get("level") for r in lab.values()).most_common())
    print("ratings", sorted(collections.Counter(r.get("rating") for r in lab.values()).items(), key=str))
    was = {r["id"]: r["cat"] for r in rows(os.path.join(ROOT, "classified.jsonl"))}
    moved = collections.Counter(f'{was[r["id"]]} -> {r["cat"]}' for r in lab.values() if r.get("cat") and was.get(r["id"]) and r["cat"] != was[r["id"]])
    print("category corrected", sum(moved.values()), moved.most_common(8))


def clean(r):
    """keep a label's known words; drop the rest (a reader's slip never reaches the hub)"""
    out = {k: r[k] for k in ("id", "what", "pattern", "why") if r.get(k)}
    if r.get("level") in VOCAB["levels"]:
        out["level"] = r["level"]
    if r.get("motion") in VOCAB["motion"]:
        out["motion"] = r["motion"]
    if isinstance(r.get("rating"), int) and 1 <= r["rating"] <= 5:
        out["rating"] = r["rating"]
    for k, ok in (("slots", SLOTS), ("look", set(VOCAB["looks"])), ("fits", set(VOCAB["fits"]))):
        v = [x for x in r.get(k) or [] if x in ok]
        if v:
            out[k] = v
    problems(r)
    if r.get("cat") in CATS:
        out["cat"] = r["cat"]
    # two slips a hand check of 20 wave-4 labels found, common across readers (11 Oct): a text, background or shader
    # effect called a primitive (502), and a card or picture put in the button slot any:action (1,847)
    cat = out.get("cat") or r.get("cat") or ""
    if cat in ("motion/text-effect", "motion/background", "motion/shader") and out.get("level") == "primitive":
        out["level"] = "effect"
    if cat.startswith(("data-display/", "media/")) and "any:action" in out.get("slots", []):
        to = "any:media" if cat.startswith("media/") else "any:data"
        out["slots"] = list(dict.fromkeys(to if s == "any:action" else s for s in out["slots"]))
    out["pattern"] = re.sub(r"\s+", " ", str(out.get("pattern", ""))).strip().lower()[:40] or None
    return out


def merge():
    lab = labels()
    _, cls, copy = to_type()
    n = 0
    tmp = os.path.join(ROOT, "types.jsonl.part")  # written whole, then swapped in: a reader never sees half a file
    with open(tmp, "w") as f:
        for r in cls:
            src = lab.get(r["id"]) or lab.get(r.get("base") or "") or lab.get(copy.get(r["id"], ""))
            if not src:
                continue
            t = clean(src)
            t["id"] = r["id"]
            if src["id"] != r["id"]:
                t["from"] = src["id"]  # a variant or copy takes its base's type
            f.write(json.dumps(t, ensure_ascii=False) + "\n")
            n += 1
    os.replace(tmp, os.path.join(ROOT, "types.jsonl"))
    print(f"types.jsonl: {n} parts ({len(lab)} read)")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=["batches", "check", "merge"])
    ap.add_argument("--size", type=int, default=200)
    ap.add_argument("--prefix", default="b")
    ap.add_argument("--held", action="store_true", help="only parts whose code is held")
    ap.add_argument("--ids", help="only the parts listed in this file, one id a line (those whose pictures are drawn)")
    ap.add_argument("--match", help="only parts whose id matches (a later pull's parts while another's pictures are drawn)")
    a = ap.parse_args()
    {"batches": lambda: batches(a.size, a.prefix, a.match, a.held, a.ids), "check": check, "merge": merge}[a.cmd]()


if __name__ == "__main__":
    main()

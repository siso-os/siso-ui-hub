#!/usr/bin/env python3
"""Pull the parts of shadcn registries that live only on GitHub (Shaan, 11 Oct: "get all of the components downloaded").
bin/find-registries lists every repository holding a registry.json (_data/ui-hub/registries-github.jsonl); most serve no
built registry, so each part is built here the way `shadcn build` does: the repository's tarball is read once, as a stream,
and each item's files get their content from it. Out: r/gh-<owner>-<repo>/ with _index.json and a part file per item,
exactly like bin/pull's, so bin/pull --catalog, classify, dupes and render take them as they are.

  bin/pull-github                      # every repository not already held, not a template or test
  bin/pull-github --only owner/repo,owner/repo
  bin/pull-github --list               # which repositories it would pull, and why the rest are left
"""
import argparse, collections, concurrent.futures as cf, io, json, os, posixpath, re, subprocess, sys, tarfile, time, urllib.parse, urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
R = os.path.join(ROOT, "r")
FOUND = os.path.expanduser("~/SISO_Workspace/_data/ui-hub/registries-github.jsonl")
TRIED = os.path.expanduser("~/SISO_Workspace/_data/ui-hub/github-pull.jsonl")  # each repository tried, with what came of it
SRC = (".tsx", ".ts", ".jsx", ".js", ".mjs", ".css", ".json", ".mdx", ".md", ".vue", ".svelte", ".astro", ".html")
SKIP_DIR = re.compile(r"(^|/)(node_modules|\.next|\.git|dist|build|out|\.turbo|coverage|\.vercel)/")
MAX_FILE, MAX_REPO = 400_000, 400_000_000  # a source file bigger than this is generated; a tarball bigger is mostly assets
TEMPLATE = re.compile(r"template|starter|boilerplate|example|demo|test|fixture|playground|sandbox", re.I)
UA = "siso-ui-code/1 (+https://github.com/siso-os)"
# a key in a demo may be real: anything shaped like a live secret is masked before it is written (no secret enters git)
SECRET = re.compile(r"\b(sk_(?:live|test)_|rk_live_|gh[pousr]_|AKIA|xox[baprs]-|sk-(?:proj-)?|AIza)([0-9A-Za-z_\-]{16,})")


def mask(text):
    return SECRET.sub(lambda m: m.group(1) + "REDACTED", text) if text else text


def slug(repo):
    return "gh-" + re.sub(r"[^a-z0-9]+", "-", repo.lower()).strip("-")


def safe(name):
    parts = [p for p in name.split("/") if p not in ("", ".", "..")]
    return os.path.join(*[re.sub(r"[^A-Za-z0-9._@+-]", "_", p) for p in parts]) + ".json" if parts else None


def found():
    """repo -> (ref, [registry.json paths]) from the code search's links (github.com/<repo>/blob/<ref>/<path>)"""
    out = collections.OrderedDict()
    for l in open(FOUND):
        try:
            r = json.loads(l)
        except ValueError:
            continue
        m = re.match(r"https://github\.com/[^/]+/[^/]+/blob/([^/]+)/(.+)", r.get("url") or "")
        if not m:
            continue
        ref, path = m.group(1), urllib.parse.unquote(m.group(2))
        e = out.setdefault(r["repo"], [ref, []])
        if path not in e[1]:
            e[1].append(path)
    return out


def held_names():
    """the libraries already pulled, by name, and the GitHub homes shadcn's index gives them (as hubindex counts them)"""
    norm = lambda x: re.sub(r"[^a-z0-9]", "", x.lower())
    pulled = {d for d in os.listdir(R) if not d.startswith("gh-") and any(not f.startswith("_") for f in os.listdir(os.path.join(R, d)))}
    homes = set()
    for r in json.load(open(os.path.join(ROOT, "registries.json"))):
        m = re.search(r"github\.com/([^/]+)/([^/#?]+)", r.get("homepage") or "")
        if m and r["name"].lstrip("@") in pulled:
            homes.add(f"{m.group(1)}/{m.group(2)}".lower())
    held = {norm(x) for x in pulled}

    def is_held(repo):
        owner, name = repo.split("/", 1)
        return repo.lower() in homes or norm(owner) in held or norm(name) in held or any(len(h) > 5 and h in norm(name) for h in held)
    return is_held


def choose(only):
    repos = found()
    if only:
        return [(r, *repos[r]) for r in only if r in repos], {}
    is_held = held_names()
    left = collections.Counter()
    out = []
    for repo, (ref, paths) in repos.items():
        if is_held(repo):
            left["held"] += 1
        elif TEMPLATE.search(repo):
            left["template or test"] += 1
        else:
            out.append((repo, ref, paths))
    return out, left


class Capped(io.RawIOBase):
    def __init__(self, f):
        self.f, self.n = f, 0

    def readable(self):
        return True

    def readinto(self, b):
        d = self.f.read(len(b))
        self.n += len(d)
        if self.n > MAX_REPO:
            raise IOError("tarball too big")
        b[: len(d)] = d
        return len(d)


def tarball(repo, ref, token):
    """the repository's source files at the ref the search saw: path -> text (top folder dropped)"""
    url = f"https://api.github.com/repos/{repo}/tarball/{ref}"
    for i in range(4):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA, **({"Authorization": f"Bearer {token}"} if token else {})})
            with urllib.request.urlopen(req, timeout=120) as r:
                files = {}
                with tarfile.open(fileobj=io.BufferedReader(Capped(r), 1 << 20), mode="r|gz") as t:
                    for m in t:
                        if not m.isfile() or m.size > MAX_FILE:
                            continue
                        p = m.name.split("/", 1)[1] if "/" in m.name else m.name
                        if SKIP_DIR.search("/" + p) or not p.endswith(SRC):
                            continue
                        f = t.extractfile(m)
                        if f:
                            try:
                                files[p] = f.read().decode("utf-8")
                            except UnicodeDecodeError:
                                pass
                return files, None
        except urllib.error.HTTPError as e:
            if e.code in (403, 429, 500, 502, 503, 504) and i < 3:
                time.sleep(20 * (i + 1))
                continue
            return None, f"http {e.code}"
        except Exception as e:
            if "too big" in str(e):
                return None, "too big"
            if i < 3:
                time.sleep(5 * (i + 1))
                continue
            return None, str(e)[:80]
    return None, "gave up"


def build(repo, ref, paths, token):
    """every item of the repository's registry files, each with its files' content; returns (name, parts, why-not)"""
    name = slug(repo)
    files, err = tarball(repo, ref, token)
    if files is None:
        return name, 0, err
    tail = collections.defaultdict(list)  # a path the registry gives relative to a source folder of its own: found by its tail when unique
    for p in files:
        tail["/".join(p.rsplit("/", 2)[-2:])].append(p)
    by_tail = lambda p: (lambda l: files[l[0]] if len(l) == 1 else None)(tail.get("/".join(p.rsplit("/", 2)[-2:]), []))
    items = {}
    for path in paths:
        try:
            reg = json.loads(files.get(path) or "")
        except ValueError:
            continue
        base = posixpath.dirname(path)
        for x in (reg.get("items") if isinstance(reg, dict) else None) or []:
            if not isinstance(x, dict) or not x.get("name") or not safe(x["name"]):
                continue
            fl = []
            for f in x.get("files") or []:
                if isinstance(f, str):
                    f = {"path": f}
                if not isinstance(f, dict) or not f.get("path"):
                    continue
                p = f["path"][2:] if f["path"].startswith("./") else f["path"]
                text = f.get("content") or files.get(posixpath.normpath(posixpath.join(base, p))) or files.get(posixpath.normpath(p)) or by_tail(p)
                fl.append({**f, **({"content": mask(text)} if text else {})})
            part = {"$schema": "https://ui.shadcn.com/schema/registry-item.json", **{k: v for k, v in x.items() if k != "files"}, "files": fl}
            have = any(f.get("content") for f in fl)
            if have or x["name"] not in items:
                items[x["name"]] = (part, have)
    if not any(have for _, have in items.values()):
        return name, 0, "no items" if not items else "no file found"
    out = os.path.join(R, name)
    os.makedirs(out, exist_ok=True)
    status, got = {}, 0
    for n, (part, have) in items.items():
        if not have:
            status[n] = "missing"
            continue
        dst = os.path.join(out, safe(n))
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        with open(dst, "w") as f:
            json.dump(part, f, ensure_ascii=False, indent=1)
        got += 1
    index = {"name": name, "homepage": f"https://github.com/{repo}", "listed_by": "github", "repo": repo, "ref": ref,
             "items": [{**{k: v for k, v in p.items() if k not in ("$schema", "files")}, "files": [{k: v for k, v in f.items() if k != "content"} for f in p["files"]]} for p, _ in items.values()]}
    with open(os.path.join(out, "_index.json"), "w") as f:
        json.dump(index, f, ensure_ascii=False, indent=1)
    with open(os.path.join(out, "_status.json"), "w") as f:
        json.dump(dict(sorted(status.items())), f, indent=1)
    return name, got, None if got else "no file found"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--only", default="")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--jobs", type=int, default=6)
    ap.add_argument("--refresh", action="store_true", help="pull a repository again even when it is held")
    a = ap.parse_args()
    todo, left = choose([s.strip() for s in a.only.split(",") if s.strip()])
    if not a.refresh:
        tried = {json.loads(l)["repo"] for l in open(TRIED)} if os.path.exists(TRIED) else set()
        todo = [t for t in todo if t[0] not in tried and not os.path.exists(os.path.join(R, slug(t[0]), "_index.json"))]
    print(f"{len(todo)} repositories to pull; left: {dict(left)}", flush=True)
    if a.list:
        for t in todo:
            print(t[0], len(t[2]))
        return
    token = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True).stdout.strip()
    total, why, done = 0, collections.Counter(), 0
    with cf.ThreadPoolExecutor(a.jobs) as ex:
        for t, (name, got, err) in zip(todo, ex.map(lambda t: build(*t, token), todo)):
            done += 1
            with open(TRIED, "a") as f:
                f.write(json.dumps({"repo": t[0], "reg": name, "parts": got, "why": err, "at": time.strftime("%Y-%m-%dT%H:%M")}) + "\n")
            total += got
            if err:
                why[err.split(":")[0][:30]] += 1
            print(f"{done}/{len(todo)} {name}: {got}{' (' + err + ')' if err else ''} · {total} parts", flush=True)
    print(f"pulled {total} parts from {len(todo)} repositories; not pulled: {dict(why)}", flush=True)


if __name__ == "__main__":
    main()

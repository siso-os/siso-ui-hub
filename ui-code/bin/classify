                             (r"versus|\bvs\b|competitor|model|product", "This versus that"), (r"\bwhy\b|cards?|feature|side|split", "Why us")],
    "status/skeleton": [(r"card", "Cards"), (r"table|list|items", "Tables and lists"), (r"profile|avatar|user", "Profiles"), (r"form", "Forms"),
                        (r"\barticles?\b|text|content", "Text and articles"), (r"shimmer|glass|animat", "Shimmer")],
    "navigation/pagination": [(r"table|data|rows", "For tables"), (r"ellipsis", "With ellipsis"), (r"first|last|advanced", "First and last"),
                              (r"compact|simple|only|minimal", "Compact"), (r"bordered|rounded|floating|glass|icon|buttons", "Styled")],
    "navigation/breadcrumb": [(r"dropdown|select|menu|collapse", "With dropdowns"), (r"ellipsis|truncat|compact", "Truncated"),
                              (r"separator|slash|\bdot\b|chevron|arrow", "Separators"), (r"icons?|home", "With icons"),
                              (r"pill|glass|background|bordered|card", "Pills and styled")],
    "navigation/command-palette": [(r"shortcut|keyboard|kbd", "Shortcuts"), (r"search|filter", "Search"), (r"dialog|modal|popover|overlay", "Dialogs"),
                                   (r"action|menu|picker", "Actions and menus")],
    "data-display/empty-state": [(r"result|search|filter", "No results"), (r"error|fail|access|denied|offline", "Errors"),
                                 (r"first|\byet\b|onboard|invite|get-?started|project|team", "First use"), (r"ecommerce|cart|order", "Shop"),
                                 (r"data|load", "No data")],
    "inputs/search": [(r"filter", "With filters"), (r"result|highlight|suggest", "With results"), (r"expand|animat", "Expanding"),
                      (r"command|selector|panel", "Command style"), (r"product|ecommerce", "Product search"), (r"bar|field|input", "Search bars")],
    "inputs/otp-input": [(r"verification|verify|auth|email|login", "Verification"), (r"\bpin\b|digits", "PIN"), (r"separator", "With separator"),
                         (r"animat|interactive", "Animated"), (r"state|validation|error", "States")],
    "motion/number-ticker": [(r"countdown|timer|clock", "Countdowns and timers"), (r"sliding|roll|odometer|slot", "Sliding and rolling"),
                             (r"currency|stat|price|money", "Money and stats"), (r"word|text", "Words"), (r"counter|count", "Counters")],
    "ai-agent/composer": [(r"suggest", "With suggestions"), (r"attach|context|media|file", "With attachments"), (r"selector|model", "Model pickers"),
                          (r"chat|message|comment", "Chat composers"), (r"prompt|input|bar", "Prompt inputs")],
    "marketing/announcement": [(r"countdown|sale|discount|offer|coupon", "Sales and countdowns"), (r"topbar|top-?bar|bar|band|ribbon", "Top bars"),
                               (r"banners?", "Banners"), (r"ecommerce|cart|shopping|product|promo", "Shop promos"), (r"card", "Cards")],
    "overlays/notifications": [(r"email|mail|mjml", "Email"), (r"inbox|center|centre|list|feed", "Inbox and centre"), (r"bell|badge|count", "Bell and badge"),
                               (r"settings|preferences", "Settings"), (r"empty", "Empty")],
    "marketing/about": [(r"mission|values|vision|statement|principles", "Mission and values"), (r"founder|team|people", "Founders and team"),
                        (r"story|timeline|history|journey", "Story"), (r"stats|numbers", "With stats"), (r"photo|image|gallery", "With photos"),
                        (r"split|grid|columns|cards?", "Split and grid")],
})
# a short word inside a longer one is not that word: "ai" in "painted", "log" in "dialog", "pro" in "product", "ios" in
# "scenarios", "ink" in "blink" (10 Oct: a hand-painted hero was "SaaS and AI"). These are matched whole, plurals allowed.
SHORT = "ai|app|ray|pin|pie|tel|ink|mic|orb|ios|row|map|log|api|new|pro|tag|win|git|bun|dot|box|bar|run|kit|tap|sun|job"
_whole = lambda p: re.sub(rf"(?:^|(?<=\|))({SHORT})(?=\||$)", r"\\b\1s?\\b", p)
SUBS = {k: [(re.compile(_whole(p), re.I), s) for p, s in v] for k, v in SUBS.items()}

STYLE = [(r"framer-motion|^motion$|motion/react|gsap|react-spring|@react-spring|auto-animate|lottie|motion-v", "animated"),
         (r"three|@react-three|ogl|webgl|glsl|shader|regl|pixi", "webgl"), (r"\b3d\b|perspective|tilt|depth", "3d"), (r"glass|frost|blur-?card", "glass"),
         (r"neon|glow|cyber|synthwave", "neon"), (r"hud|sci-?fi|terminal|retro|pixel|8-?bit|crt|ascii", "retro and HUD"), (r"gradient|aurora|mesh", "gradient"),
         (r"minimal|simple|clean|basic", "minimal"), (r"brutal", "brutalist"), (r"playful|bouncy|fun|cartoon|doodle|sketch|hand-?drawn", "playful")]
STYLE = [(re.compile(p, re.I), s) for p, s in STYLE]
DOMAIN = [(r"\bai\b|agent|llm|chat|prompt|model|assistant|copilot|openai|anthropic|reason", "AI"), (r"auth|login|sign-?(in|up)|oidc|oauth|password|2fa|session", "auth"),
          (r"pricing|billing|subscription|invoice|checkout|payment|stripe|plan|usage", "billing"), (r"cart|product|shop|store|commerce|order", "commerce"),
          (r"crypto|wallet|token|swap|defi|web3|ethereum|solana|nft", "crypto"), (r"map|geo|location|globe", "maps"), (r"email|mail|newsletter", "email"),
          (r"terminal|code|git|deploy|dev|api|cli|log", "dev tools"), (r"video|audio|music|podcast|media", "media"), (r"health|fitness|medical", "health"),
          (r"finance|bank|stock|trading", "finance")]
DOMAIN = [(re.compile(p, re.I), s) for p, s in DOMAIN]

TYPE_CAT = {"registry:hook": "lib/hook", "registry:lib": "lib/utility", "registry:theme": "themes/theme", "registry:style": "themes/style",
            "registry:font": "assets/font", "registry:base": "themes/style", "registry:file": "lib/utility"}
NUMBERED = re.compile(r"^(.*?)[\s_-]*(v?\d{1,4}|[ivx]{1,4})$", re.I)
VARIANT_PREFIX = re.compile(r"^(v|var|variant|demo|example|preview|ex)-", re.I)
VARIANT_SUFFIX = re.compile(r"[-_](demo|example|examples|preview|usage|default|basic|story|stories)(-\d+)?$", re.I)
FLAVOUR = re.compile(r"^(.*)-(JS|TS)-(CSS|TW)$")  # react-bits: each part four ways, JS or TS, CSS or Tailwind
# canvas-ui and supabase: one part per framework (glyph-rain-react, glyph-rain-vue, glyph-rain-react-webgpu)
FRAMEWORK = re.compile(r"^(.*)-(react|vue|svelte|solid|preact|vanilla|angular|lit|qwik)(-webgpu|-webgl)?$", re.I)


def words(x):
    """the part's name text: name, title, its registry categories and its file's folder and name (never the registry's
    own name, which leaks: "shadcn-dashboard/select-01" is a select), kebab, camel and letter-digit split"""
    reg = x["reg"].lower()
    paths = []
    for p in (x.get("files") or [])[:2]:
        segs = [q for q in p.rsplit(".", 1)[0].split("/") if q.lower() not in (reg, "registry", "src", "components", "ui", "default", "new-york", "base", "blocks", "block", "lib", "registry-ui")]
        paths.append(" ".join(segs[-2:]))
    bits = [x.get("name") or "", x.get("title") or "", " ".join(x.get("categories") or [])] + paths
    t = " ".join(bits)
    t = re.sub(r"([a-z])([A-Z])", r"\1 \2", t)
    t = re.sub(r"([A-Za-z])(\d)", r"\1 \2", t)
    return re.sub(r"[_/.@]+", " ", t).lower().replace(reg, " ")


def framework(x):
    exts = {p.rsplit(".", 1)[-1].lower() for p in x.get("files") or [] if "." in p}
    deps = " ".join(x.get("deps") or [])
    if "vue" in exts or "motion-v" in deps or "vue" in deps.split():
        return "Vue"
    if "svelte" in exts:
        return "Svelte"
    if "res" in exts:
        return "ReScript"
    if "solid-js" in deps:
        return "Solid"
    if "@angular" in deps:
        return "Angular"
    if exts & {"tsx", "jsx", "ts", "js"}:
        return "React"
    if exts & {"css", "scss"}:
        return "CSS"
    return None


KNOWN_ICON_SETS = {"keyline", "lucide-animated"}


def icon_sets(rows):
    """registries that are icon sets: named so, or nearly all their parts named or filed as icons (not "lexicon")"""
    n, icons = collections.Counter(), collections.Counter()
    for x in rows:
        n[x["reg"]] += 1
        s = (x["name"] + " " + (x.get("description") or "") + " " + " ".join(x.get("files") or [])[:300]).lower()
        if re.search(r"\bicons?\b|icons/|-icon\b", s):
            icons[x["reg"]] += 1
    return {r for r in n if r in KNOWN_ICON_SETS or (n[r] >= 20 and (icons[r] >= 0.95 * n[r] or re.search(r"(^|-)icons|icons(-|$)", r)))}


STRONG = RULES[:7]  # what a part is FOR (an asset, an AI part) outranks what it is shaped like
# words that name a part only as its whole name or last word ("steps", "task-steps"); anywhere else in its text they
# say too little (beste-ui's about12 mentions steps)
HEAD_ONLY = [(re.compile(p), c) for p, c in [
    (r"^icons-", "assets/icon"), (r"^icon-(?!.*\b(button|btn|picker|input|menu|toggle|cloud|set|grid)\b)", "assets/icon"),  # icon-timer is an icon, icon-swap-button a button
    (r"^about(-?us)?(-|$)", "marketing/about"),  # an About section (shadcnblocks' about-31-story-with-avatar-profile), 174 spread over 8 places
    (r"^(\w+-)?steps?$", "navigation/wizard-steps"), (r"^(\w+-)?crm$", "layout/dashboard"), (r"^(\w+-)?command$", "navigation/command-palette"),  # shadcn's Command
    (r"^(\w+-)?(timer|countdown|count-down)$", "motion/number-ticker")]]
ASSETS = 5  # the first five rules are assets: a "logo grid" is a section of logos, not a logo
TAIL = {"demo", "demos", "example", "examples", "preview", "usage", "default", "basic", "story", "stories", "component",
        "components", "block", "blocks", "section", "sections", "ui", "new", "simple", "variant", "variants", "primary",
        "secondary", "custom", "base", "shadcnui", "shadcn"}
TAIL |= {"sm", "md", "lg", "xl", "xs", "2xl", "3x", "2x"}  # a size (wigggle-ui's weather-sm-09) says nothing about what it is
CONTAINER = {"card", "cards", "grid", "list", "item", "items", "wrapper", "container", "box", "group", "form", "tile",
             "tiles", "widget", "view", "panel", "row", "table"}
WEAK = {"picker", "input", "field", "selector", "select", "editor"}  # "date range picker" is a date range: longest first
# the things an effect is put on: a "footer brand backdrop" is a footer, a "button text marquee" a button
THING = [(rx, c) for rx, c in RULES[ASSETS:] if c.startswith(("marketing/", "actions/", "overlays/")) or c in ("data-display/card", "navigation/top-nav")]
MARKETING = [(rx, c) for rx, c in RULES if c.startswith("marketing/")]
# what a container holds is its purpose, never its look: a "spotlight card" is a card, a "pricing card" is pricing
PURPOSE = [(rx, c) for rx, c in RULES[ASSETS:] if not c.startswith(("motion/", "themes/"))]


def head_words(s):
    """a name's words, without the trailing ones that say nothing about what it is (demo, 01, section, primary)"""
    s = re.sub(r"([a-z])([A-Z])", r"\1 \2", s or "")
    s = re.sub(r"([A-Za-z])(\d)", r"\1 \2", s)
    ws = [w for w in re.split(r"[^A-Za-z0-9]+", s.lower()) if w]
    if "with" in ws[1:]:  # "pricing with switch" is pricing
        ws = ws[:ws.index("with", 1)]
    for n in (3, 2, 1):  # "button-button-text-marquee" (shadcnblocks): the repeated prefix is the category
        if len(ws) > 2 * n and ws[:n] == ws[n:2 * n]:
            return ws[:n]
    while len(ws) > 1 and (ws[-1] in TAIL or re.fullmatch(r"v?\d+", ws[-1])):
        ws.pop()
    return ws


def singular(w):
    """a plural head as the thing it names ("modals" is a modal, "heros" a hero); "status", "glass", "canvas" stay"""
    if len(w) > 4 and w.endswith("ies"): return w[:-3] + "y"
    if len(w) > 4 and re.search(r"(x|ch|sh)es$", w): return w[:-2]
    if len(w) > 3 and w.endswith("s") and not re.search(r"(ss|us|is|as)$", w): return w[:-1]
    return w


# a library with no registry that is all one kind of thing (bin/sites); and where to put the parts of one whose
# names say nothing ("sender", "think" in Ant Design X are AI chat parts)
SITE_CAT = {"dicebear": "assets/avatar", "react-flow-xyflow": "data-viz/flow", "audiocn": "media/player"}  # audiocn: an audio UI kit, not sounds
SITE_FALLBACK = {"ant-design-x": "ai-agent/ai-agent", "llm-ui": "ai-agent/ai-agent", "photocn": "media/gallery"}


def by_head(ws):
    """the rule that names the head: in English the last word names the thing ("accordion gallery" is a gallery, "icon
    trail button" a button), so the last word, then the last two, and on. A container ("pricing card", "logo grid",
    "login form") is named by what it holds, so its modifier goes first."""
    first = lambda s, rules=RULES: next((c for rx, c in rules if rx.search(s)), None)
    if len(ws) > 1 and ws[-1] in CONTAINER:
        c = first("-".join(ws[:-1][-2:]), PURPOSE) or first("-".join(ws[-2:]), PURPOSE)
        if c:
            return c
    for k in (3, 2):  # a compound name the rules know whole ("context menu", "hover card", "number ticker")
        t = "-".join(ws[-k:]) if len(ws) >= k else ""
        for rx, c in RULES if t else []:
            m = rx.search(t)
            if m and m.start() == 0 and m.end() == len(t):
                return c
    ks = range(len(ws), 0, -1) if ws and ws[-1] in WEAK else range(1, len(ws) + 1)
    for k in ks:
        c = first("-".join(ws[-k:]))
        if c:
            if c.startswith("motion/") and k < len(ws):
                return first("-".join(ws[:-k]), THING) or c
            return c
    return None


# A description's subject names the part; its later words name what it holds or does ("It features ...", "three
# columns", "follows the cursor"). 10 Oct: of 30 parts where the subject and the first rule word anywhere disagreed, the
# subject was right 18 times and the rule word 9.
DESC_CUT = re.compile(r"\.\s|:\s|;\s|,\s| [—–-] | (?:that|which|with|for|where|using|built|featuring|powered|designed|"
                      r"inspired|to|in|on|from|by)\s", re.I)


def desc_head(d):
    """a description's subject: from "A push-notification approval card that ...", the words push-notification approval card"""
    d = re.sub(r"^\s*(this|a|an|the)\s+", "", d.strip(), flags=re.I)
    return DESC_CUT.split(d, maxsplit=1)[0].strip()


def sub_of(x, cat):
    """a part's finer place in CAT: the first of the category's subcategories its words match"""
    t = words(x) + " " + " ".join(x.get("deps") or [])
    return next((s for rx, s in SUBS.get(cat, []) if rx.search(t)), None)


def classify(x, icon_regs, sound_regs, logo_regs):
    t = (x.get("type") or "")
    text = words(x)
    desc = (x.get("description") or "").lower()
    cat = None
    if x["reg"] in icon_regs:
        cat = "assets/icon"
    elif x["reg"] in sound_regs or re.search(r"/sounds?/", " ".join(x.get("files") or [])):
        cat = "assets/sound"
    elif re.search(r"og-?image", x["reg"]):
        cat = "assets/og-image"
    elif x["reg"] in logo_regs:
        cat = "assets/logo"
    elif re.search(r"flag", x["reg"]) or re.search(r"\bflag$", x.get("title") or "", re.I):
        cat = "assets/flag"
    elif x["reg"] in SITE_CAT:
        cat = SITE_CAT[x["reg"]]
    elif t in TYPE_CAT:
        cat = TYPE_CAT[t]
    nm, tt = (x.get("name") or "").split("/")[-1], (x.get("title") or "").split(" - ")[0]
    if not cat and re.search(r"\bsections?\b", f"{nm} {tt}".replace("-", " "), re.I):
        s = f"{nm} {tt} {desc}".lower()
        cat = next((c for rx, c in MARKETING if rx.search(s)), None)
    if not cat:
        cat = next((c for rx, c in STRONG if rx.search(f"{nm} {tt}".lower())), None)
    if not cat:
        cat = next((c for rx, c in HEAD_ONLY if rx.search("-".join(head_words(nm)))), None)
    if not cat:
        cat = by_head(head_words(nm)) or by_head(head_words(tt)) or by_head([singular(w) for w in head_words(nm)])
    if not cat:
        for rx, c in RULES:
            if rx.search(text):
                cat = c
                break
    if not cat and desc:  # what the description says it is first ("A collapsible tree for ..." is a tree), then any rule's word
        ws = head_words(desc_head(desc).replace(" ", "-"))
        cat = (by_head(ws) or by_head([singular(w) for w in ws])) if ws else None
    if not cat and desc:
        for rx, c in RULES:
            if rx.search(desc):
                cat = c
                break
    if not cat:
        cat = SITE_FALLBACK.get(x["reg"])
    if not cat:
        cat = "marketing/marketing" if t == "registry:block" else "pages/templates" if t == "registry:page" else "other/other"
    # a block named like an element is that element's section form: keep the element's place
    deps = " ".join(x.get("deps") or [])
    sub = None
    for rx, s in SUBS.get(cat, []):
        if rx.search(text + " " + deps):
            sub = s
            break
    style = sorted({s for rx, s in STYLE if rx.search(text + " " + deps + " " + desc)})
    domain = sorted({s for rx, s in DOMAIN if rx.search(text + " " + desc)})
    return cat, sub, style, domain


def base_of(x, names):
    """the base part a variant or example belongs to, within its own registry"""
    n = x["name"]
    leaf = n.split("/")[-1]
    t = x.get("type") or ""
    f = FLAVOUR.match(leaf)
    if f:  # one part and three flavours of it: the first flavour held stands for all four
        pre = n[: len(n) - len(leaf)]
        first = next((pre + f"{f.group(1)}-{k}" for k in ("JS-CSS", "JS-TW", "TS-CSS", "TS-TW") if pre + f"{f.group(1)}-{k}" in names), None)
        return first if first != n else None
    g = FRAMEWORK.match(leaf)
    if g:  # the same part for another framework or renderer: React's (else the first) stands for all of them
        pre = n[: len(n) - len(leaf)]
        same = lambda m: m.startswith(pre + g.group(1) + "-") and (FRAMEWORK.match(m[len(pre):]) or [None, None])[1] == g.group(1)
        sibs = sorted(m for m in names if same(m))
        if len(sibs) >= 2:
            first = pre + g.group(1) + "-react" if pre + g.group(1) + "-react" in names else sibs[0]
            return first if first != n else None
    cand = []
    stem = VARIANT_SUFFIX.sub("", VARIANT_PREFIX.sub("", leaf))
    m = NUMBERED.match(stem)
    stems = [stem] + ([m.group(1).rstrip("-_ ")] if m and m.group(1) else [])
    for s in stems:
        for prefix in ("", "/".join(n.split("/")[:-1]) + "/" if "/" in n else ""):
            if prefix + s in names and prefix + s != n:
                cand.append(prefix + s)
    for u in x.get("uses") or []:
        u = re.sub(r"\.json$", "", u.rsplit("/", 1)[-1].split(":")[-1].lstrip("@"))
        if u in names and u != n and u not in cand:
            cand.append(u)
    is_variant = t == "registry:example" or bool(VARIANT_PREFIX.match(leaf) or VARIANT_SUFFIX.search(leaf))
    # "alert-outlined-secondary" uses "@uiable/alert" and starts with it: a styled variant of its base
    for c in cand:
        if is_variant or leaf.startswith(c.split("/")[-1] + "-") or leaf.startswith(c.split("/")[-1] + "_"):
            return c
    return None


def display_name(x, cat, labels):
    raw = (x.get("title") or x["name"].split("/")[-1]).strip()
    m = NUMBERED.match(raw.replace("_", "-"))
    plain = re.sub(r"[-_]+", " ", raw).strip()
    if m and (not m.group(1) or len(m.group(1).strip(" -_")) <= 14) and re.search(r"\d", m.group(2)):
        what = (m.group(1) or "").strip(" -_")
        what = re.sub(r"[-_]+", " ", what).strip() or labels.get(cat, cat.split("/")[-1])
        return f"{what[:1].upper()}{what[1:]} #{int(re.sub(r'[^0-9]', '', m.group(2)) or 0)}"
    return plain[:1].upper() + plain[1:] if plain.islower() else plain


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--sample", type=int, default=0)
    ap.add_argument("--catalog", default=os.path.join(ROOT, "catalog.jsonl"))
    ap.add_argument("--out", default=os.path.join(ROOT, "classified.jsonl"))
    args = ap.parse_args()
    rows = [json.loads(l) for l in open(args.catalog)]
    # the libraries with no registry: their parts are their pages (bin/sites), sorted by name like any other part
    sites = os.path.join(ROOT, "sites.jsonl")
    if args.catalog == os.path.join(ROOT, "catalog.jsonl") and os.path.exists(sites):
        rows += [json.loads(l) for l in open(sites)]
    rows = [x for x in rows if x["reg"] != "registrydirectory"]
    # svgl's registry leaves out each logo's category; its API has it (svgl-categories.json, from https://api.svgl.app)
    svgl = os.path.join(ROOT, "svgl-categories.json")
    svgl = json.load(open(svgl)) if os.path.exists(svgl) else {}
    for x in rows:
        if x["reg"] == "svgl" and not x.get("categories") and svgl.get(x["name"]):
            x["categories"] = svgl[x["name"]]
    icon_regs = icon_sets(rows)
    # a library of sound files by its name; "audio" also matched ramonclaudio-coderabbit (CodeRabbit's API client) and audiocn's players
    sound_regs = {r for r in {x["reg"] for x in rows} if re.search(r"sound|sfx", r)}
    logo_regs = {r for r in {x["reg"] for x in rows} if re.search(r"logo", r)} | {"svgl"}  # svgl: brand logos
    names = collections.defaultdict(set)
    for x in rows:
        names[x["reg"]].add(x["name"])
    # brand icons: a library whose icons mostly name brands (efferd: apple, discord, openai) files them with the logos.
    # svgl's names are the brands; a library qualifies when 5+ of its icon parts and half of them name one.
    stem = lambda n: re.sub(r"(^|-)(icons?|logos?|brand)(?=-|$)", "", n.split("/")[-1].lower()).strip("-")
    brands = {stem(x["name"]) for x in rows if x["reg"] == "svgl"} - {""}
    tally = collections.defaultdict(lambda: [0, 0])
    for x in rows:
        if x["reg"] not in icon_regs and re.search(r"(^|-)icons?(-|$)", x["name"].split("/")[-1].lower()):
            tally[x["reg"]][0] += 1; tally[x["reg"]][1] += stem(x["name"]) in brands
    brand_regs = {r for r, (n, b) in tally.items() if n >= 5 and b >= n / 2}
    labels = {}
    # a reader's call outranks the rules: overrides.jsonl, one {"id", "cat", "sub"?, "by"} or {"id", "junk": true, "by"} per line (Haiku agents and
    # Shaan's own corrections; 10 Oct, the 2,776 parts no rule could place)
    ov_path = os.path.join(ROOT, "overrides.jsonl")
    ov = {o["id"]: o for o in (json.loads(l) for l in open(ov_path) if l.strip())} if os.path.exists(ov_path) else {}
    out = []
    counts = collections.Counter()
    subs = collections.defaultdict(collections.Counter)
    for x in rows:
        cat, sub, style, domain = classify(x, icon_regs, sound_regs, logo_regs)
        if cat == "assets/icon" and x["reg"] in brand_regs and stem(x["name"]) in brands:
            cat, sub = "assets/logo", sub_of(x, "assets/logo")
        o = ov.get(x["id"])
        if o and o.get("cat") and o["cat"] != cat:
            cat, sub = o["cat"], o.get("sub") or sub_of(x, o["cat"])  # a reader's place, and the sub its words name there
        junk = bool(o and o.get("junk"))  # a reader found a test or gibberish: kept here, left out of the hub
        base = base_of(x, names[x["reg"]])
        fw = framework(x)
        row = {"id": x["id"], "cat": cat, "sub": sub, "base": f"{x['reg']}/{base}" if base else None, "fw": fw, "style": style or None,
               "domain": domain or None, "dn": display_name(x, cat, labels), "junk": junk}
        out.append({k: v for k, v in row.items() if v})
        if not base and not junk:
            counts[cat] += 1
            if sub:
                subs[cat][sub] += 1
    # a base inherits nothing, but a variant takes its base's category, so a base's variants sort with it
    by_id = {r["id"]: r for r in out}
    for r in out:
        b = by_id.get(r.get("base") or "")
        if b:
            r["cat"] = b["cat"]
            if b.get("sub"): r["sub"] = b["sub"]  # and its finer place: a variant's own words no longer pick a sub of a place it left
            else: r.pop("sub", None)
    if args.sample:
        random.seed(7)
        for r in random.sample(out, args.sample):
            print(json.dumps(r, ensure_ascii=False))
        return
    with open(args.out, "w") as f:
        for r in out:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")
    tax = {"_about": "The parts' vocabulary: group/category as in the UI Hub, the subcategories bin/classify gives the crowded ones, and how many base parts (variants aside) each has.",
           "icon_sets": sorted(icon_regs), "sound_sets": sorted(sound_regs), "logo_sets": sorted(logo_regs),
           "categories": [{"category": c, "parts": n, "subs": dict(subs[c].most_common())} for c, n in counts.most_common()]}
    json.dump(tax, open(os.path.join(os.path.dirname(args.out), "taxonomy.json"), "w"), indent=1, ensure_ascii=False)
    nb = sum(1 for r in out if r.get("base"))
    print(f"{len(out)} parts: {len(out) - nb} bases, {nb} variants or examples; {len(counts)} categories; "
          f"other: {counts['other/other']}; icons {sum(1 for r in out if r['cat'] == 'assets/icon')}")


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Pull every part's code from the shadcn registries: r/<registry>/<name>.json, listed in catalog.jsonl.

Each part is a shadcn registry item: its files with their contents, its npm dependencies and the parts it builds on,
the same JSON `npx shadcn add <url>` installs. Shaan, 10 Oct: "the whole point is we're supposed to have the code for
this shit ... We should have all the code on a github or downloaded".

Idempotent: a part already on disk is not fetched again, and a part the registry refused (gated, missing) is not asked
again unless --retry. Polite: at most three requests at a time to one host, with backoff on 429 and 5xx.

  bin/pull                          # every registry in registries.json
  bin/pull --only spaceui,000h-cojeev
  bin/pull --limit 5                # the first 5 parts of each registry, to try it
  bin/pull --commit                 # commit each registry as it finishes, push every few minutes (the workflow does)
  bin/pull --catalog                # only rebuild catalog.jsonl from what is held
  bin/pull --commit --stream        # and drop each registry's parts from disk once committed (a sparse clone; see AGENTS.md)

What is held is what git tracks, so a sparse clone that keeps only the indexes still knows every part it has pulled.
"""
import argparse, concurrent.futures as cf, json, os, random, re, subprocess, sys, threading, time, urllib.error, urllib.parse, urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
R = os.path.join(ROOT, "r")
UA = "siso-ui-code/1 (+https://github.com/sisodias)"
# aggregators: their parts are other registries' parts under a prefix, so they are pulled at the source instead
SKIP = {"registrydirectory"}
OK, GATED, MISSING, ERROR = "ok", "gated", "missing", "error"


def get(url, tries=4):
    for i in range(tries):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
            with urllib.request.urlopen(req, timeout=30) as r:
                return r.status, r.read()
        except urllib.error.HTTPError as e:
            if e.code in (429, 500, 502, 503, 504) and i < tries - 1:
                wait = e.headers.get("Retry-After") or ""
                time.sleep(min(int(wait), 60) if wait.isdigit() else 3 * 2**i + random.random())
                continue
            return e.code, b""
        except Exception:
            if i < tries - 1:
                time.sleep(2 * 2**i)
                continue
            return 0, b""
    return 0, b""


def slug(name):
    return name.lstrip("@")


def url_for(reg, name):
    u = reg["url"].replace("{name}", "/".join(urllib.parse.quote(p, safe="") for p in name.split("/")))
    return u.replace("{style}", reg.get("_style") or STYLES[0])


# a registry whose url has {style} serves each part per style; the CLI fills in the project's, we take the first that answers
STYLES = ("new-york-v4", "new-york", "default", "base-nova")
# an aggregator's list names other registries' parts as "<registry>/<part>": the parts of a registry with no index of its own
DIRECTORY = "https://registry.directory/r/registry.json"
_directory = None


def directory_items(name):
    global _directory
    if _directory is None:
        st, b = get(DIRECTORY)
        try:
            _directory = (json.loads(b).get("items") or []) if st == 200 else []
        except Exception:
            _directory = []
    pre = name + "/"
    return [dict(x, name=x["name"][len(pre):]) for x in _directory if isinstance(x, dict) and str(x.get("name", "")).startswith(pre)]


def sitemap_items(origin):
    """a part name per docs page in the site's sitemap (Shaan, 11 Oct: "all of the sitemap urls"); a wrong guess is a 404"""
    st, b = get(origin + "/sitemap.xml")
    locs = re.findall(r"<loc>([^<]+)</loc>", b.decode("utf-8", "replace")) if st == 200 else []
    pat = re.compile(r"/(?:docs|components?|blocks?|ui|elements|primitives|patterns)(?:/[^/]+)?/([a-z0-9][a-z0-9-]*)$")
    names = [m.group(1) for u in locs if (m := pat.search(urllib.parse.urlparse(u).path.rstrip("/")))]
    return [{"name": n} for n in dict.fromkeys(names)]


def find_index(reg):
    """its index where the CLI looks, then where others keep theirs, then the aggregator's list, then its sitemap
    (11 Oct: 48 registries in shadcn's own index had never been pulled because their index sits elsewhere or nowhere)"""
    tpl = reg["url"]
    origin = "{0.scheme}://{0.netloc}".format(urllib.parse.urlparse(tpl))
    tries = [u for u in [load(os.path.join(ROOT, "registry-lists.json"), {}).get(slug(reg["name"]))] if u]  # a list found by hand, often its GitHub registry.json
    tries += [tpl.replace("{name}", n).replace("{style}/", "") for n in ("registry", "index")]
    tries += [origin + p for p in ("/registry.json", "/r/registry.json", "/r/index.json", "/registry/index.json")]
    for u in dict.fromkeys(tries):
        st, b = get(u, tries=2)
        try:
            d = json.loads(b) if st == 200 else None
        except Exception:
            d = None
        if isinstance(d, list):
            d = {"items": d}
        if isinstance(d, dict) and isinstance(d.get("items"), list) and d["items"]:
            return d, u
    for how, items in (("registry.directory", directory_items(slug(reg["name"]))), ("sitemap", sitemap_items(origin))):
        if items:
            return {"name": slug(reg["name"]), "items": items, "listed_by": how}, how
    return None, None


def safe(name):
    """a part's file path under its registry: its own name, slashes kept as folders, nothing that climbs out"""
    parts = [p for p in name.split("/") if p not in ("", ".", "..")]
    return os.path.join(*[re.sub(r"[^A-Za-z0-9._@+-]", "_", p) for p in parts]) + ".json" if parts else None


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def tracked(prefix):
    """the part files git holds under a prefix, as paths relative to it; a streamed clone has them in the index, not on disk"""
    r = subprocess.run(["git", "--no-optional-locks", "-C", ROOT, "ls-files", "-z", "--", prefix], capture_output=True, text=True)
    n = len(prefix.rstrip("/")) + 1
    return {x[n:] for x in r.stdout.split("\0") if x} if r.returncode == 0 else set()


def has_code(body):
    try:
        d = json.loads(body)
    except Exception:
        return False
    return isinstance(d, dict) and any(isinstance(f, dict) and f.get("content") for f in d.get("files") or [])


def pull_registry(reg, args, log):
    name = slug(reg["name"])
    out = os.path.join(R, name)
    index, where = find_index(reg)
    if not index:
        log(f"{name}: no index (nor an aggregator's list or a sitemap)")
        return name, 0, {}
    os.makedirs(out, exist_ok=True)
    with open(os.path.join(out, "_index.json"), "w") as f:
        json.dump(index, f, ensure_ascii=False, indent=1)
    seen = load(os.path.join(out, "_status.json"), {})
    held = tracked(f"r/{name}")
    items = [x for x in index["items"] if isinstance(x, dict) and x.get("name")]
    if args.limit:
        items = items[: args.limit]
    todo = []
    for x in items:
        p = safe(x["name"])
        if not p:
            continue
        if (p in held or os.path.exists(os.path.join(out, p))) and not args.refresh:
            continue
        if seen.get(x["name"]) in (GATED, MISSING) and not args.retry:
            continue
        todo.append((x["name"], p))

    if "{style}" in reg["url"] and todo:  # the first style that serves the first part serves them all
        for sty in STYLES:
            if get(reg["url"].replace("{name}", urllib.parse.quote(todo[0][0], safe="/")).replace("{style}", sty), tries=2)[0] == 200:
                reg["_style"] = sty
                break

    def one(job):
        n, p = job
        st, b = get(url_for(reg, n))
        if st == 200 and has_code(b):
            dst = os.path.join(out, p)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, "wb") as f:
                f.write(b)
            return n, OK
        return n, GATED if st in (401, 402, 403) else MISSING if st in (404, 410) or st == 200 else ERROR

    got = 0
    with cf.ThreadPoolExecutor(3) as ex:
        for n, st in ex.map(one, todo):
            if st == OK:
                got += 1
                seen.pop(n, None)
            else:
                seen[n] = st
    with open(os.path.join(out, "_status.json"), "w") as f:
        json.dump(dict(sorted(seen.items())), f, indent=1)
    log(f"{name}: {len(items)} parts listed, {got} pulled now, {sum(1 for v in seen.values() if v != OK)} refused")
    return name, got, seen


def catalog():
    """one row per part, from every registry's index: what it is, what it needs, and whether we hold its code"""
    regs = {slug(r["name"]): r for r in load(os.path.join(ROOT, "registries.json"), [])}
    held = tracked("r")
    rows = 0
    with open(os.path.join(ROOT, "catalog.jsonl"), "w") as f:
        for name in sorted(os.listdir(R)) if os.path.isdir(R) else []:
            index = load(os.path.join(R, name, "_index.json"), None)
            if not index:
                continue
            seen = load(os.path.join(R, name, "_status.json"), {})
            reg = regs.get(name, {})
            for x in index.get("items") or []:
                if not isinstance(x, dict) or not x.get("name"):
                    continue
                p = safe(x["name"])
                have = bool(p) and (f"{name}/{p}" in held or os.path.exists(os.path.join(R, name, p)))
                row = {
                    "id": f"{name}/{x['name']}", "reg": name, "name": x["name"], "type": x.get("type"), "title": x.get("title"),
                    "description": (x.get("description") or "")[:300], "categories": x.get("categories"),
                    "deps": x.get("dependencies"), "devDeps": x.get("devDependencies"), "uses": x.get("registryDependencies"),
                    "files": [fl.get("path") for fl in x.get("files") or [] if isinstance(fl, dict)],
                    "code": f"r/{name}/{p}" if have else None, "status": OK if have else seen.get(x["name"], "not-pulled"),
                    "install": url_for(reg, x["name"]) if reg else None, "homepage": index.get("homepage") or reg.get("homepage"),
                }
                f.write(json.dumps({k: v for k, v in row.items() if v not in (None, [], "")}, ensure_ascii=False) + "\n")
                rows += 1
    return rows


def git(*a, tries=6):
    """git, retried while another git holds the index (10 Oct: a `git status` beside the pull cost termcn its commit)"""
    for i in range(tries):
        r = subprocess.run(["git", "-C", ROOT, *a], capture_output=True, text=True)
        if r.returncode == 0 or "index.lock" not in r.stderr or i == tries - 1:
            return r
        time.sleep(2 + i)


def push():
    """push, and when main has moved on (a merged PR), rebase the pull's commits onto it first"""
    r = git("push", "-q")
    if r.returncode:
        git("pull", "--rebase", "-q")
        r = git("push", "-q")
    return r


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--only", default="")
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--retry", action="store_true")
    ap.add_argument("--commit", action="store_true")
    ap.add_argument("--catalog", action="store_true")
    ap.add_argument("--stream", action="store_true")
    ap.add_argument("--jobs", type=int, default=32)
    args = ap.parse_args()
    if args.catalog:
        print(f"catalog: {catalog()} parts")
        return
    if args.commit:
        git("pull", "--rebase", "-q")
    regs = load(os.path.join(ROOT, "registries.json"), [])
    only = {s.strip().lstrip("@") for s in args.only.split(",") if s.strip()}
    regs = [r for r in regs if (slug(r["name"]) in only if only else slug(r["name"]) not in SKIP)]
    lock = threading.Lock()
    last_push = [time.time()]

    def log(msg):
        with lock:
            print(msg, flush=True)

    def done(name, got):
        if not args.commit:
            return
        with lock:
            git("add", "--sparse", f"r/{name}")
            if git("diff", "--cached", "--quiet").returncode:
                git("commit", "-q", "-m", f"{name}: {got} parts pulled")
            if args.stream:
                git("sparse-checkout", "reapply")
            if time.time() - last_push[0] > 240:
                push()
                last_push[0] = time.time()

    total = 0
    with cf.ThreadPoolExecutor(args.jobs) as ex:
        futs = [ex.submit(pull_registry, r, args, log) for r in regs]
        for fu in cf.as_completed(futs):
            name, got, _ = fu.result()
            total += got
            done(name, got)
    rows = catalog()
    print(f"pulled {total} parts this run; catalog: {rows} parts across {len(regs)} registries", flush=True)
    if args.commit:
        git("add", "--sparse", "-A", "r", "catalog.jsonl")
        if git("diff", "--cached", "--quiet").returncode:
            git("commit", "-q", "-m", f"catalog: {rows} parts")
        push()


if __name__ == "__main__":
    sys.exit(main())

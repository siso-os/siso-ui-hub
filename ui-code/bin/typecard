#!/usr/bin/env python3
"""A short card per part, for a reader (ECOSYSTEM or a Haiku agent) writing its detailed type (types/README.md).

Shaan, 11 Oct 02:4x: "we didn't actually start going through these comps and categorizing them into what types they were
in a more detailed spec". A card is what a reader needs to say what a part is, where it goes and how good it is, in about
a tenth of its code: its name and the registry's words, its category, packages, exports, props, the words it shows,
the Tailwind it leans on, its size, and where its picture is.

  bin/typecard ID ...                  # cards for these ids, as text
  bin/typecard --ids FILE --jsonl      # one JSON card per line (ids one per line, or jsonl rows with "id")
"""
import argparse, collections, json, os, re, sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
THUMBS = os.environ.get("UI_THUMBS", os.path.expanduser("~/SISO_Workspace/_data/ui-hub/thumbs"))
LOOK = re.compile(r"^(bg-gradient|bg-linear|bg-radial|bg-conic|from-|via-|to-|backdrop-|blur|drop-shadow|shadow|ring|animate-|"
                  r"grid-cols|col-span|md:grid-cols|lg:grid-cols|perspective|rotate|skew|mix-blend|bg-clip-text|text-transparent|"
                  r"rounded-(2xl|3xl|full)|border-dashed|font-mono|uppercase|tracking-|text-(5xl|6xl|7xl|8xl|9xl)|h-screen|min-h-screen|aspect-)")


def load(path):
    return {r["id"]: r for r in map(json.loads, open(path))}


def main_file(files, name):
    code = [f for f in files if re.search(r"\.(tsx|jsx|vue|svelte|ts|js)$", f.get("path", "")) and f.get("content")]
    if not code:
        return None
    same = [f for f in code if re.sub(r"\.\w+$", "", os.path.basename(f["path"])).lower() in (name.lower(), name.lower().replace("-", ""))]
    return (same or sorted(code, key=lambda f: -f["content"].count("<")))[0]


def card(row, cls):
    c = cls.get(row["id"], {})
    out = {"id": row["id"], "name": row.get("title") or row["name"], "cat": c.get("cat"), "sub": c.get("sub")}
    if row.get("description"):
        out["says"] = row["description"][:200]
    if row.get("deps"):
        out["deps"] = list(row["deps"])[:12]  # a registry may give its deps as an object (name: version)
    files = []
    if row.get("code") and os.path.exists(os.path.join(ROOT, row["code"])):
        try:
            files = json.load(open(os.path.join(ROOT, row["code"]))).get("files") or []
        except Exception:
            files = []
    f = main_file(files, row["name"])
    if f:
        s = f["content"]
        out["lines"] = sum(x.get("content", "").count("\n") for x in files)
        out["files"] = len(files)
        out["exports"] = sorted(set(re.findall(r"export\s+(?:default\s+)?(?:async\s+)?(?:function|const|class)\s+([A-Za-z_]\w*)", s)))[:8]
        props = re.search(r"(?:interface|type)\s+\w*Props\w*\s*=?\s*(?:[^{]*)\{([^}]{0,900})\}", s)
        if props:
            out["props"] = [p.strip().rstrip(";,") for p in props.group(1).split("\n") if re.match(r"\s*\w+\??\s*:", p)][:10]
        words = [w.strip() for w in re.findall(r">\s*([^<>{}\n]{3,60}?)\s*<", s)]
        words += re.findall(r"(?:title|label|placeholder|alt|heading|description)\s*[:=]\s*[\"']([^\"']{3,60})[\"']", s)
        out["shows"] = list(dict.fromkeys(w for w in words if re.search(r"[A-Za-z]{3}", w)))[:14]
        toks = collections.Counter(t.split(":")[-1] for t in re.findall(r"[\w:\-\[\]./#%]+", " ".join(re.findall(r"className=\{?[`\"']([^`\"']+)", s))))
        out["tw"] = [t for t, _ in toks.most_common(80) if LOOK.match(t)][:16]
        out["tags"] = sorted({t for t, ok in (("svg", "<svg" in s), ("canvas", "<canvas" in s or "getContext(" in s), ("video", "<video" in s),
                                               ("img", "<img" in s or "<Image" in s), ("form", "<form" in s or "onSubmit" in s),
                                               ("table", "<table" in s or "<Table" in s), ("state", "useState" in s),
                                               ("effect", "useEffect" in s), ("aria", "aria-" in s), ("media-query", "md:" in s or "sm:" in s),
                                               ("dark", "dark:" in s), ("tokens", bool(re.search(r"\b(bg|text)-(primary|muted|card|foreground|background|accent)\b", s)))) if ok})
    pic = os.path.join(THUMBS, row["reg"], row["name"] + ".webp")
    if os.path.exists(pic):
        out["picture"] = pic
    return out


def text(c):
    head = f"## {c['id']}  [{c.get('cat')}{' / ' + c['sub'] if c.get('sub') else ''}]  {c.get('name')}"
    rest = [f"  {k}: {', '.join(map(str, v)) if isinstance(v, list) else v}" for k, v in c.items() if k not in ("id", "cat", "sub", "name") and v not in (None, [], "")]
    return "\n".join([head] + rest)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("ids", nargs="*")
    ap.add_argument("--ids", dest="file")
    ap.add_argument("--jsonl", action="store_true")
    a = ap.parse_args()
    ids = list(a.ids)
    if a.file:
        for line in open(a.file):
            line = line.strip()
            if line:
                ids.append(json.loads(line)["id"] if line.startswith("{") else line)
    cat, cls = load(os.path.join(ROOT, "catalog.jsonl")), load(os.path.join(ROOT, "classified.jsonl"))
    for i in ids:
        if i not in cat:
            print(f"## {i}  (not in the catalog)", file=sys.stderr)
            continue
        c = card(cat[i], cls)
        print(json.dumps(c, ensure_ascii=False) if a.jsonl else text(c))


if __name__ == "__main__":
    main()
